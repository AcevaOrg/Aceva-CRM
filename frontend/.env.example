# "mock" uses the in-memory demo data in src/mocks. "live" calls the NestJS API.
NEXT_PUBLIC_API_MODE=mock
# Base URL of the NestJS API (used when NEXT_PUBLIC_API_MODE=live or for the modules in NEXT_PUBLIC_LIVE_MODULES)
NEXT_PUBLIC_API_URL=/api/v1
# Switch single modules to the real API while the rest stay on mock data (comma list). Modules 1 to 5 against a local API:
#NEXT_PUBLIC_LIVE_MODULES=m1,m2,m3,m4,m5
#NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Show the Phase 2 Sales zone and Integrations (M15, M16)
NEXT_PUBLIC_ENABLE_PHASE2=true
