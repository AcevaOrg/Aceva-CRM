  recurringRules RecurringBillingRule[]

  @@index([kind, name])
  @@map("parties")
}

/// Projects for tagging entries (profit by project). Minimal list owned by M9 until a projects module exists.
model FinanceProject {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code       String    @unique
  name       String
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy  String?   @map("created_by") @db.Uuid
