// Aceva Digital System: shared database model (Cycle 1: M1 hierarchy, M2 login, M3 profiles; Cycle 2: M4 activity).
//
// Conventions (development plan section 22):
//  * Internal IDs are random UUIDs. People only ever see Emp-IDs (ACV-0001).
//  * Times are timestamptz (stored in UTC). Dates without a time are @db.Date.
//  * Money is NUMERIC(12,2), never a float.
//  * Mutable tables carry created_at / created_by / updated_at / updated_by.
//    created_by / updated_by hold an employee UUID but are NOT foreign keys, so the
//    very first seed rows and system jobs can be written. They are filled by the app.
//  * Nothing important is hard-deleted: rows are archived (archived_at / ended_at / revoked_at).
//  * History tables (audit_log, profile_changes, employment_history, password_history,
//    login_attempts) accept inserts only. A database trigger blocks UPDATE and DELETE.
//  * CHECK constraints, the Emp-ID sequence, partial unique indexes and the triggers live in
//    the hand-written part of the first migration (Prisma cannot express them).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum EmploymentType {
  full_time
  part_time
  intern

  @@map("employment_type")
}

enum EmployeeStatus {
  active
  on_notice
  left

  @@map("employee_status")
}

enum DocumentType {
  cv
  contract
  cnic_copy
  certificate

  @@map("document_type")
}

enum ProfileSection {
  basic
  job
  personal
  pay

  @@map("profile_section")
}

enum EmploymentEventType {
  joined
  level_changed
  reporting_line_changed
  department_changed
  office_changed
  designation_changed
  employment_type_changed
  status_changed
  notice_given
  left

  @@map("employment_event_type")
}

enum AuditOutcome {
  success
  denied

  @@map("audit_outcome")
}

enum HireRequestStatus {
  pending
  approved
  rejected

  @@map("hire_request_status")
}

enum JobStatus {
  pending
  running
  succeeded
  failed

  @@map("job_status")
}

/// What an activity event records (spec section 9.4). The last five come from connected sales tools (Module 16).
enum ActivityAction {
  login
  logout
  login_failed
  screen_view
  create
  edit
  delete
  submit
  assign
  approve
  reject
  comment
  upload
  download
  export
  print
  sensitive_view
  blocked
  security
  email_sent
  reply
  bounce
  call
  email_check

  @@map("activity_action")
}

/// The security alert rules of plan section 8 ("Alerts the system raises").
enum AlertKind {
  account_locked
  new_device
  outside_hours
  large_export
  salary_views
  finance_attempts

  @@map("alert_kind")
}

enum AlertSeverity {
  low
  medium
  high

  @@map("alert_severity")
}

/// Task size (plan section 9). XL cannot be assigned: it must be split first.
enum TaskSize {
  XS
  S
  M
  L
  XL

  @@map("task_size")
}

/// The task status flow. "Overdue" is NOT a status: it is worked out from the deadline.
enum TaskStatus {
  assigned
  in_progress
  submitted
  under_review
  approved
  rework
  on_hold
  cancelled

  @@map("task_status")
}

enum TaskPriority {
  low
  medium
  high
  urgent

  @@map("task_priority")
}

enum ExtensionStatus {
  pending
  approved
  rejected

  @@map("extension_status")
}

/// A reviewer either approves (with a rating) or sends the task back (with a reason).
enum ReviewDecision {
  approved
  rework

  @@map("review_decision")
}

enum RepeatUnit {
  week
  month

  @@map("repeat_unit")
}

/// What one line of a task's history is. Only "status" changes the status; the other kinds are recorded with
/// from = to = the current status so the screen can show one timeline.
enum TaskHistoryKind {
  created
  status
  deadline_changed
  extension_requested
  extension_approved
  extension_rejected
  reassigned
  transferred
  edited
  repeat_stopped

  @@map("task_history_kind")
}

/// Module 6: which set of weights and metrics a scorecard uses. Sales staff are scored with the sales weights.
enum ScorecardKind {
  standard
  sales

  @@map("scorecard_kind")
}

/// draft (with the reviewer) -> released (to the employee) -> acknowledged (by the employee). Only forward.
enum ScorecardStatus {
  draft
  released
  acknowledged

  @@map("scorecard_status")
}

/// 85 to 100 excellent, 70 to 84.9 good, 50 to 69.9 needs improvement, below 50 poor. Null when nothing could be measured.
enum ScorecardBand {
  excellent
  good
  needs_improvement
  poor

  @@map("scorecard_band")
}

/// How a task stood when the scorecard was made: approved, handed in and waiting for review, still open, or cancelled.
enum ScorecardTaskStatus {
  approved
  submitted
  open
  cancelled

  @@map("scorecard_task_status")
}

enum ScorecardCommentKind {
  reviewer_remark
  employee_comment

  @@map("scorecard_comment_kind")
}

enum DisputeStatus {
  open
  upheld
  changed

  @@map("dispute_status")
}

// ---------------------------------------------------------------------------
// M1: levels, roles, permissions, duties, departments, offices
// ---------------------------------------------------------------------------

/// The five organisational levels: 1 CEO / Founder / Owner, 2 Director, 3 CTO, 4 Sales and Finance, 5 Developer / SQA.
model Level {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  number      Int      @unique
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy   String?  @map("created_by") @db.Uuid
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy   String?  @map("updated_by") @db.Uuid

  roles     Role[]
  employees Employee[]

  @@map("levels")
}

/// A named set of permissions. Every level has exactly one default role (is_default).
model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique
  name        String
  description String?
  levelId     String   @map("level_id") @db.Uuid
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy   String?  @map("created_by") @db.Uuid
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy   String?  @map("updated_by") @db.Uuid

  level           Level                    @relation(fields: [levelId], references: [id])
  rolePermissions RolePermission[]
  employees       Employee[]
  ruleAsManager   SameLevelReportingRule[] @relation("RuleManagerRole")
  ruleAsEmployee  SameLevelReportingRule[] @relation("RuleEmployeeRole")

  @@index([levelId])
  @@map("roles")
}

/// One allowed action, for example task.assign, finance.view, payroll.approve.
/// New modules add rows here; the authorization code does not change.
model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique
  module      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy   String?  @map("created_by") @db.Uuid
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy   String?  @map("updated_by") @db.Uuid

  rolePermissions RolePermission[]
  dutyPermissions DutyPermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy    String?  @map("created_by") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// An extra duty on top of a person's role, for example Finance or HR.
/// Duties carry their own permissions (kept separate from role permissions).
model Duty {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key               String   @unique
  name              String
  description       String?
  /// 2FA is mandatory for anyone holding this duty (plan section 6: Finance duty).
  requiresTwoFactor Boolean  @default(false) @map("requires_two_factor")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy         String?  @map("created_by") @db.Uuid
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy         String?  @map("updated_by") @db.Uuid

  dutyPermissions DutyPermission[]
  employeeDuties  EmployeeDuty[]

  @@map("duties")
}

model DutyPermission {
  dutyId       String   @map("duty_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy    String?  @map("created_by") @db.Uuid

  duty       Duty       @relation(fields: [dutyId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([dutyId, permissionId])
  @@index([permissionId])
  @@map("duty_permissions")
}

/// A duty given to an employee. Ending a duty sets ended_at (the row is kept).
/// One active row per employee and duty (partial unique index in the migration).
model EmployeeDuty {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId String    @map("employee_id") @db.Uuid
  dutyId     String    @map("duty_id") @db.Uuid
  reason     String?
  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  endedAt    DateTime? @map("ended_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy  String?   @map("created_by") @db.Uuid
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy  String?   @map("updated_by") @db.Uuid

  employee Employee @relation(fields: [employeeId], references: [id])
  duty     Duty     @relation(fields: [dutyId], references: [id])

  @@index([employeeId])
  @@index([dutyId])
  @@map("employee_duties")
}

model Department {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code           String    @unique
  name           String    @unique
  /// The department head, set explicitly by the Director (never worked out from reporting lines).
  headEmployeeId String?   @map("head_employee_id") @db.Uuid
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy      String?   @map("created_by") @db.Uuid
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy      String?   @map("updated_by") @db.Uuid

  employees Employee[]
  head      Employee?      @relation("DepartmentHead", fields: [headEmployeeId], references: [id])
  weightVersions ScoreWeightVersion[]
  /// Module 14 department channels (back-relation only).
  channels  Conversation[]
  /// Module 14 announcements sent to this department (back-relation only).
  announcements AnnouncementDepartment[]

  @@index([headEmployeeId])
  @@map("departments")
}

model Office {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code       String    @unique
  name       String    @unique
  city       String?
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy  String?   @map("created_by") @db.Uuid
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy  String?   @map("updated_by") @db.Uuid

  employees Employee[]

  @@map("offices")
}

// ---------------------------------------------------------------------------
// M3 (central record, used by M1 and M2): the employee
// ---------------------------------------------------------------------------

/// THE one employee record. Every module links to this table.
/// Holds the Basic and Job sections. Personal and Pay data live in their own
/// one-to-one tables so a directory or list query can never leak them by accident.
model Employee {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// ACV-0001, ACV-0002 ... generated by the database from a sequence.
  /// Never changes (trigger) and is never reused (employees are never deleted).
  empId String @unique @default(dbgenerated("('ACV-'::text || lpad((nextval('emp_id_seq'::regclass))::text, 4, '0'::text))")) @map("emp_id")

  // Basic (visible to everyone through the staff directory)
  fullName      String  @map("full_name")
  photoKey      String? @map("photo_key")
  designation   String
  departmentId  String  @map("department_id") @db.Uuid
  officeId      String  @map("office_id") @db.Uuid
  /// Official acevatech.com address. Null when the person has none.
  officialEmail String? @unique @map("official_email")

  // Job (visible to the employee and the levels above)
  levelId             String         @map("level_id") @db.Uuid
  roleId              String         @map("role_id") @db.Uuid
  /// The primary reporting relationship. Null only for the CEO / Founder / Owner (Level 1).
  reportsToId         String?        @map("reports_to_id") @db.Uuid
  joiningDate         DateTime       @map("joining_date") @db.Date
  employmentType      EmploymentType @default(full_time) @map("employment_type")
  status              EmployeeStatus @default(active)
  lastWorkingDay      DateTime?      @map("last_working_day") @db.Date
  weeklyCapacityHours Int            @default(40) @map("weekly_capacity_hours")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy String?  @map("updated_by") @db.Uuid

  department    Department   @relation(fields: [departmentId], references: [id])
  headOf        Department[] @relation("DepartmentHead")
  office        Office       @relation(fields: [officeId], references: [id])
  level         Level        @relation(fields: [levelId], references: [id])
  role          Role         @relation(fields: [roleId], references: [id])
  reportsTo     Employee?    @relation("ReportsTo", fields: [reportsToId], references: [id])
  directReports Employee[]   @relation("ReportsTo")

  personal              EmployeePersonal?
  pay                   EmployeePay?
  duties                EmployeeDuty[]
  ancestors             ReportingClosure[]     @relation("ClosureDescendant")
  descendants           ReportingClosure[]     @relation("ClosureAncestor")
  standInsAsManager     StandIn[]              @relation("StandInManager")
  standInsAsCover       StandIn[]              @relation("StandInCover")
  credential            Credential?
  totpSecret            TotpSecret?
  passwordHistory       PasswordHistory[]
  passwordResets        PasswordResetToken[]
  sessions              Session[]
  loginAttempts         LoginAttempt[]
  employmentHistory     EmploymentHistory[]
  profileChanges        ProfileChange[]
  documents             EmployeeDocument[]
  hireRequestsMade      HireRequest[]          @relation("HireRequester")
  hireRequestsDecided   HireRequest[]          @relation("HireDecider")
  hireRequestOf         HireRequest?           @relation("HireResult")
  auditEntries          AuditLog[]
  activityEvents        ActivityEvent[]
  activityHeartbeats    ActivityHeartbeat[]
  activitySummaries     ActivityDailySummary[]
  securityAlerts        SecurityAlert[]        @relation("AlertSubject")
  alertChecks           SecurityAlertCheck[]   @relation("AlertChecker")
  tasksOwned            Task[]                 @relation("TaskAssignee")
  tasksAssigned         Task[]                 @relation("TaskAssigner")
  taskReviews           TaskReview[]           @relation("TaskReviewer")
  taskComments          TaskComment[]          @relation("TaskCommentAuthor")
  taskMentions          TaskCommentMention[]   @relation("TaskMentioned")
  taskExtensions        TaskExtension[]        @relation("ExtensionRequester")
  taskExtensionsDecided TaskExtension[]        @relation("ExtensionDecider")
  taskHistoryEntries    TaskHistory[]          @relation("TaskHistoryActor")
  taskAttachments       TaskAttachment[]       @relation("TaskAttachmentUploader")
  weightVersionsMade    ScoreWeightVersion[]   @relation("WeightVersionAuthor")
  scorecards            Scorecard[]            @relation("ScorecardOwner")
  scorecardsToReview    Scorecard[]            @relation("ScorecardReviewer")
  scorecardsReleased    Scorecard[]            @relation("ScorecardReleaser")
  scorecardComments     ScorecardComment[]     @relation("ScorecardCommentAuthor")
  disputesRaised        RatingDispute[]        @relation("DisputeRaiser")
  disputesToDecide      RatingDispute[]        @relation("DisputeDecider")
  disputesDecided       RatingDispute[]        @relation("DisputeDecidedBy")

  // M7, M8, M9 (back-relations only; added by the schema owner in the shared foundation migration)
  attendanceRecords     AttendanceRecord[]
  attendanceCorrections AttendanceCorrection[]
  leaveEntitlements     LeaveEntitlement[]
  leaveRequests         LeaveRequest[]
  payrollLines          PayrollLine[]
  payrollItems          PayrollItem[]
  payrollAdjustments    PayrollAdjustment[]
  salaryAdvances        SalaryAdvance[]
  payslips              Payslip[]
  finalSettlements      FinalSettlement[]
  journalLines          JournalLine[]

  // Cycle 3 foundation (back-relations only)
  notifications          Notification[]
  notificationPreference NotificationPreference?
  invoicesAssigned       Invoice[]               @relation("InvoiceAssignee")
  recurringRulesAssigned RecurringBillingRule[]  @relation("RecurringRuleAssignee")
  subscriptionsOwned     Subscription[]          @relation("SubscriptionOwner")

  // Module 14 (back-relations only)
  conversationMemberships ConversationMember[]
  conversationReads       ConversationRead[]
  departmentChannelAccess DepartmentChannelAccess[]
  messagesAuthored        Message[]                 @relation("MessageAuthor")
  messageMentions         MessageMention[]          @relation("MessageMentioned")
  messageReactions        MessageReaction[]
  savedMessages           SavedMessage[]
  announcementsAuthored   Announcement[]            @relation("AnnouncementAuthor")
  announcementsPinned     Announcement[]            @relation("AnnouncementPinnedBy")
  announcementAcks        AnnouncementAck[]
  meetingsOrganized       Meeting[]                 @relation("MeetingOrganizer")
  meetingNotesEdited      Meeting[]                 @relation("MeetingNotesEditor")
  meetingsCancelled       Meeting[]                 @relation("MeetingCanceller")
  meetingParticipations   MeetingParticipant[]      @relation("MeetingParticipant")
  meetingInvitesSent      MeetingParticipant[]      @relation("MeetingInviter")
  commsFilesUploaded      CommsFile[]
  messageTaskLinks        MessageTaskLink[]
  meetingTaskLinks        MeetingTaskLink[]

  // Module 15 (back-relations only)
  salesLeadsOwned         SalesLead[]               @relation("SalesLeadOwner")
  salesDealsOwned         SalesDeal[]               @relation("SalesDealOwner")
  salesWonRequested       SalesDeal[]               @relation("SalesDealWonRequester")
  salesWonConfirmed       SalesDeal[]               @relation("SalesDealWonConfirmer")
  salesDealHistory        SalesDealHistory[]
  salesActivities         SalesActivity[]
  salesDncEntries         SalesDncEntry[]
  salesImportsMade        SalesImportBatch[]        @relation("SalesImportCreatedBy")
  salesImportsOwned       SalesImportBatch[]        @relation("SalesImportOwner")
  salesLeadsArchived      SalesLeadArchive[]
  salesReassignIssues     SalesReassignmentIssue[]  @relation("SalesReassignLeaver")
  salesReassignResolved   SalesReassignmentIssue[]  @relation("SalesReassignResolvedTo")
  salesWonExceptionsMade  SalesWonException[]       @relation("SalesWonExceptionDecider")
  salesWonExceptionsAsked SalesWonException[]       @relation("SalesWonExceptionRequester")
  salesWonExceptionsWas   SalesWonException[]       @relation("SalesWonExceptionOwnerAtRequest")
  salesWonExceptionsOwner SalesWonException[]       @relation("SalesWonExceptionCurrentOwner")
  salesDailyTargets       SalesDailyTarget[]        @relation("SalesDailyTargetFor")
  salesDailyTargetsSet    SalesDailyTarget[]        @relation("SalesDailyTargetSetBy")
  salesMonthlyTargets     SalesMonthlyTarget[]      @relation("SalesMonthlyTargetFor")
  salesMonthlyTargetsSet  SalesMonthlyTarget[]      @relation("SalesMonthlyTargetSetBy")
  salesDailyLogs          SalesDailyLog[]
  salesDailyReports       SalesDailyReport[]
  salesProofRequests      SalesProofRequest[]       @relation("SalesProofFor")
  salesProofRequested     SalesProofRequest[]       @relation("SalesProofRequestedBy")
  salesProofClosed        SalesProofRequest[]       @relation("SalesProofClosedBy")
  // Module 15.7: commission
  salesCommissionRulesSet       SalesCommissionRule[]      @relation("SalesCommissionRuleSetBy")
  salesCommissionEarned         SalesCommissionLine[]      @relation("SalesCommissionEarner")
  salesCommissionWonOwned       SalesCommissionLine[]      @relation("SalesCommissionWonOwner")
  salesCommissionHeld           SalesCommissionLine[]      @relation("SalesCommissionHeldBy")
  salesCommissionApproved       SalesCommissionLine[]      @relation("SalesCommissionApprovedBy")
  salesCommissionRejected       SalesCommissionLine[]      @relation("SalesCommissionRejectedBy")
  salesCommissionLeaverDecided  SalesCommissionLine[]      @relation("SalesCommissionLeaverDecidedBy")
  salesCommissionEvents         SalesCommissionLineEvent[]
  salesCommissionEligibility    SalesCommissionEligibility[]

  @@index([departmentId])
  @@index([officeId])
  @@index([levelId])
  @@index([roleId])
  @@index([reportsToId])
  @@index([status])
  @@map("employees")
}

/// Personal section: the employee, HR, the Director and the CEO / Founder / Owner (view only).
model EmployeePersonal {
  employeeId               String   @id @map("employee_id") @db.Uuid
  /// AES-256-GCM ciphertext (encrypted by the app, never stored in plain text).
  cnicEncrypted            String?  @map("cnic_encrypted")
  cnicLast4                String?  @map("cnic_last4")
  phone                    String?
  homeAddress              String?  @map("home_address")
  emergencyContactName     String?  @map("emergency_contact_name")
  emergencyContactPhone    String?  @map("emergency_contact_phone")
  emergencyContactRelation String?  @map("emergency_contact_relation")
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy                String?  @map("created_by") @db.Uuid
  updatedAt                DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy                String?  @map("updated_by") @db.Uuid

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("employee_personal")
}

/// Pay section: the employee (own only), the Director, the CEO / Founder / Owner (view only) and the finance duty person.
model EmployeePay {
  employeeId           String   @id @map("employee_id") @db.Uuid
  baseSalary           Decimal  @default(0) @map("base_salary") @db.Decimal(12, 2)
  allowances           Decimal  @default(0) @db.Decimal(12, 2)
  bankName             String?  @map("bank_name")
  /// AES-256-GCM ciphertext.
  bankAccountEncrypted String?  @map("bank_account_encrypted")
  bankAccountLast4     String?  @map("bank_account_last4")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy            String?  @map("created_by") @db.Uuid
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy            String?  @map("updated_by") @db.Uuid

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("employee_pay")
}

// ---------------------------------------------------------------------------
// M1: reporting tree helper and stand-ins
// ---------------------------------------------------------------------------

/// Closure table for the reporting tree. One row for every (manager above, person below) pair,
/// plus a depth-0 row for each person themselves. Rebuilt in the same transaction as any
/// change to reports_to_id. Lets "everyone below me" be one indexed query.
model ReportingClosure {
  ancestorId   String   @map("ancestor_id") @db.Uuid
  descendantId String   @map("descendant_id") @db.Uuid
  depth        Int
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  ancestor   Employee @relation("ClosureAncestor", fields: [ancestorId], references: [id])
  descendant Employee @relation("ClosureDescendant", fields: [descendantId], references: [id])

  @@id([ancestorId, descendantId])
  @@index([descendantId])
  @@map("reporting_closure")
}

/// A manager names a stand-in for set dates; approvals go to the stand-in meanwhile.
model StandIn {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  managerId String    @map("manager_id") @db.Uuid
  /// Null = the manager is away with no stand-in, so approvals go one level up.
  standInId String?   @map("stand_in_id") @db.Uuid
  startsOn  DateTime  @map("starts_on") @db.Date
  endsOn    DateTime  @map("ends_on") @db.Date
  reason    String?
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy String?   @map("updated_by") @db.Uuid

  manager Employee  @relation("StandInManager", fields: [managerId], references: [id])
  standIn Employee? @relation("StandInCover", fields: [standInId], references: [id])

  @@index([managerId, startsOn, endsOn])
  @@index([standInId])
  @@map("stand_ins")
}

/// Same-level reporting is allowed ONLY where listed here. In the final structure NO pair is listed: everybody reports
/// to someone at a strictly higher level. Level and reporting line are separate concepts.
model SameLevelReportingRule {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  managerRoleId  String   @map("manager_role_id") @db.Uuid
  employeeRoleId String   @map("employee_role_id") @db.Uuid
  reason         String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy      String?  @map("created_by") @db.Uuid

  managerRole  Role @relation("RuleManagerRole", fields: [managerRoleId], references: [id])
  employeeRole Role @relation("RuleEmployeeRole", fields: [employeeRoleId], references: [id])

  @@unique([managerRoleId, employeeRoleId])
  @@map("same_level_reporting_rules")
}

// ---------------------------------------------------------------------------
// M2: credentials, 2FA, sessions, login attempts, password history and reset
// ---------------------------------------------------------------------------

/// Login credentials. Argon2id hash only. Nobody can read the password.
model Credential {
  employeeId          String    @id @map("employee_id") @db.Uuid
  passwordHash        String    @map("password_hash")
  /// True for a temporary password: the person must choose a new one at next login.
  mustChangePassword  Boolean   @default(true) @map("must_change_password")
  passwordChangedAt   DateTime? @map("password_changed_at") @db.Timestamptz(3)
  failedAttempts      Int       @default(0) @map("failed_attempts")
  lockedAt            DateTime? @map("locked_at") @db.Timestamptz(3)
  /// Set when the last working day is processed. A disabled login can never sign in.
  loginDisabledAt     DateTime? @map("login_disabled_at") @db.Timestamptz(3)
  /// Set when two-step login was reset (lost phone): a fresh authenticator MUST be set up at the next login.
  mustEnrollTwoFactor Boolean   @default(false) @map("must_enroll_two_factor")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy           String?   @map("created_by") @db.Uuid
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy           String?   @map("updated_by") @db.Uuid

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("credentials")
}

/// TOTP authenticator secret, stored encrypted (AES-256-GCM).
model TotpSecret {
  employeeId      String    @id @map("employee_id") @db.Uuid
  secretEncrypted String    @map("secret_encrypted")
  /// Which encryption key was used (lets us rotate keys later).
  keyId           String    @default("v1") @map("key_id")
  /// Null until the person proves they can generate a valid code.
  confirmedAt     DateTime? @map("confirmed_at") @db.Timestamptz(3)
  /// The last 30-second time step that was accepted, so one code cannot be used twice.
  lastUsedStep    BigInt?   @map("last_used_step")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy       String?   @map("created_by") @db.Uuid
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy       String?   @map("updated_by") @db.Uuid

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("totp_secrets")
}

/// Previous password hashes, to block reuse of the last three. Insert-only.
model PasswordHistory {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId   String   @map("employee_id") @db.Uuid
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy    String?  @map("created_by") @db.Uuid

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, createdAt(sort: Desc)])
  @@map("password_history")
}

/// One-time password reset link. Only the SHA-256 hash of the token is stored.
model PasswordResetToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId String    @map("employee_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt     DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy  String?   @map("created_by") @db.Uuid

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@map("password_reset_tokens")
}

/// A login session. The browser holds a random token; only its hash is stored here.
model Session {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId          String    @map("employee_id") @db.Uuid
  tokenHash           String    @unique @map("token_hash")
  rememberMe          Boolean   @default(false) @map("remember_me")
  twoFactorVerifiedAt DateTime? @map("two_factor_verified_at") @db.Timestamptz(3)
  /// The last time the person confirmed their password (and authenticator code) again for a risky action. Valid 5 minutes.
  stepUpAt            DateTime? @map("step_up_at") @db.Timestamptz(3)
  /// SHA-256 of the CSRF token the browser must send in the X-CSRF-Token header on every change request.
  csrfTokenHash       String?   @map("csrf_token_hash")
  ip                  String?
  userAgent           String?   @map("user_agent")
  device              String?
  browser             String?
  os                  String?
  city                String?
  lastActiveAt        DateTime  @default(now()) @map("last_active_at") @db.Timestamptz(3)
  /// Hard limit: 12 hours after login, whatever the activity.
  absoluteExpiresAt   DateTime  @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason       String?   @map("revoked_reason")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy           String?   @map("created_by") @db.Uuid

  employee       Employee            @relation(fields: [employeeId], references: [id])
  activityEvents ActivityEvent[]
  heartbeats     ActivityHeartbeat[]

  @@index([employeeId, revokedAt])
  @@index([absoluteExpiresAt])
  @@map("sessions")
}

/// Every login attempt, successful or not. Insert-only. Also drives the per-IP rate limit.
model LoginAttempt {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// What was typed in the Emp-ID box (may not match a real employee).
  empIdAttempted String   @map("emp_id_attempted")
  employeeId     String?  @map("employee_id") @db.Uuid
  ip             String
  userAgent      String?  @map("user_agent")
  success        Boolean
  failureReason  String?  @map("failure_reason")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  employee Employee? @relation(fields: [employeeId], references: [id])

  @@index([ip, createdAt])
  @@index([employeeId, createdAt])
  @@map("login_attempts")
}

// ---------------------------------------------------------------------------
// M3: history and documents
// ---------------------------------------------------------------------------

/// Job milestones: joined, level changed, moved department, on notice, left. Insert-only.
model EmploymentHistory {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId  String              @map("employee_id") @db.Uuid
  eventType   EmploymentEventType @map("event_type")
  effectiveOn DateTime            @map("effective_on") @db.Date
  details     Json?
  reason      String?
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy   String?             @map("created_by") @db.Uuid

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, effectiveOn])
  @@map("employment_history")
}

/// Field-level change history: who, when, old value, new value. Insert-only.
/// Sensitive values (CNIC, bank account, pay) are stored encrypted by the app (is_sensitive).
model ProfileChange {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId  String         @map("employee_id") @db.Uuid
  section     ProfileSection
  field       String
  oldValue    String?        @map("old_value")
  newValue    String?        @map("new_value")
  isSensitive Boolean        @default(false) @map("is_sensitive")
  reason      String?
  changedBy   String         @map("changed_by") @db.Uuid
  changedAt   DateTime       @default(now()) @map("changed_at") @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, changedAt])
  @@map("profile_changes")
}

/// Metadata for CV, contract, CNIC copy and certificates. The file itself lives in private
/// storage under storage_key; this table never contains file bytes or public URLs.
model EmployeeDocument {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId       String       @map("employee_id") @db.Uuid
  type             DocumentType
  title            String
  storageKey       String       @unique @map("storage_key")
  originalFilename String       @map("original_filename")
  mimeType         String       @map("mime_type")
  sizeBytes        Int          @map("size_bytes")
  sha256           String
  archivedAt       DateTime?    @map("archived_at") @db.Timestamptz(3)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy        String?      @map("created_by") @db.Uuid
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy        String?      @map("updated_by") @db.Uuid

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, type])
  @@map("employee_documents")
}

// ---------------------------------------------------------------------------
// Shared services: audit log, outbox, scheduled jobs
// ---------------------------------------------------------------------------

/// Who changed what and why, plus blocked access attempts. Insert-only.
model AuditLog {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  occurredAt DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(3)
  /// Null for the system or for an unauthenticated request.
  actorId    String?      @map("actor_id") @db.Uuid
  action     String
  targetType String       @map("target_type")
  targetId   String?      @map("target_id")
  outcome    AuditOutcome @default(success)
  reason     String?
  details    Json?
  ip         String?
  userAgent  String?      @map("user_agent")
  /// The HTTP request that wrote it (filled automatically from the request context). Module 4 joins activity events
  /// on it to show the old and new values of a change.
  requestId  String?      @map("request_id")

  actor Employee? @relation(fields: [actorId], references: [id])

  @@index([occurredAt])
  @@index([actorId, occurredAt])
  @@index([targetType, targetId])
  @@index([action])
  @@index([requestId])
  @@map("audit_log")
}

/// Events for other modules (see packages/contracts). Written in the same transaction as the
/// change. Two readers exist: the outbox dispatcher (backend/src/events/outbox-dispatcher.service.ts, Modules 4 to 9)
/// hands each event to every consumer registered for its type and version, then sets processed_at; the Cycle 3 consumer
/// runner (outbox-consumer-runner.service.ts: notifications, Modules 13 and 14) records its own progress in
/// outbox_consumptions and never touches processed_at.
model OutboxEvent {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type          String
  version       Int
  actor         String
  payload       Json
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)
  processedAt   DateTime? @map("processed_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// How many times the dispatcher has tried to deliver it. It stops after OUTBOX_MAX_ATTEMPTS (the row stays, unprocessed).
  attempts      Int       @default(0)
  /// Not before this time (the retry delay). Null = as soon as possible.
  nextAttemptAt DateTime? @map("next_attempt_at") @db.Timestamptz(3)
  lastError     String?   @map("last_error")
  /// A dispatcher holds the event until then while handling it; after a crash the claim simply runs out.
  lockedUntil   DateTime? @map("locked_until") @db.Timestamptz(3)
  lockedBy      String?   @map("locked_by")

  deliveries OutboxDelivery[]

  consumptions OutboxConsumption[]

  @@index([type, version, createdAt])
  @@index([processedAt])
  @@map("outbox_events")
}

/// One row per (event, consumer) once that consumer has handled the event. The dispatcher never gives the same event
/// to the same consumer again, so a retry after a partial failure only repeats the consumers that failed.
model OutboxDelivery {
  eventId     String   @map("event_id") @db.Uuid
  consumer    String
  deliveredAt DateTime @default(now()) @map("delivered_at") @db.Timestamptz(3)

  event OutboxEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@id([eventId, consumer])
  @@map("outbox_deliveries")
}

/// Settings by section (plan section 17), for example "alert-rules". Module 4 only READS it: the defaults live in the
/// code and a missing row means "use the defaults". Module 12 builds the settings screen and the audited changes.
model SystemSetting {
  section   String   @id
  values    Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy String?  @map("updated_by") @db.Uuid

  @@map("system_settings")
}

// ---------------------------------------------------------------------------
// M4: activity tracking. Every table here is insert-only (a trigger blocks UPDATE, DELETE and TRUNCATE):
// nobody, at any level, can edit or delete tracking data. Retention (plan section 8) is documented in
// docs/M4-ACCEPTANCE.md; there is no clean-up job.
// ---------------------------------------------------------------------------

/// One thing a person did, or that happened to their account: login, logout, screen opened, action, sensitive view,
/// blocked attempt, security event, or (Module 16) work counted in a connected sales tool.
model ActivityEvent {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  occurredAt    DateTime       @map("occurred_at") @db.Timestamptz(3)
  employeeId    String         @map("employee_id") @db.Uuid
  sessionId     String?        @map("session_id") @db.Uuid
  /// "aceva" for this system, or the sales tool's name (apollo, millionverifier, mailbox) when Module 16 writes it.
  source        String         @default("aceva")
  action        ActivityAction
  /// The module people see on screen, for example People, Tasks, Ledger, Login.
  module        String
  /// What it was about, for example ACV-0011 or TSK-0142.
  target        String?
  description   String
  ip            String?
  city          String?
  device        String?
  /// The HTTP request that did it. Joined with audit_log.request_id to show old and new values ("Changes").
  requestId     String?        @map("request_id") @db.Uuid
  /// Makes writes by retried consumers idempotent, for example "outbox:<event id>:login".
  dedupeKey     String?        @unique @map("dedupe_key")
  /// Linked to finance (finance screens, payroll, statements): kept as long as the finance records.
  financeLinked Boolean        @default(false) @map("finance_linked")
  /// Small structured extras (route, logout reason, rows exported). Never secrets and never request bodies.
  details       Json?
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  session  Session? @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([employeeId, occurredAt])
  @@index([occurredAt])
  @@index([sessionId, occurredAt])
  @@index([action, occurredAt])
  @@index([requestId])
  @@index([financeLinked, occurredAt])
  @@map("activity_events")
}

/// The "still here" signal the app sends every 60 seconds: only whether the mouse or keyboard was used that minute.
model ActivityHeartbeat {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId  String   @map("session_id") @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  at         DateTime @db.Timestamptz(3)
  active     Boolean
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  session  Session  @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([sessionId, at])
  @@index([employeeId, at])
  @@index([at])
  @@map("activity_heartbeats")
}

/// The nightly summary: one row per person per day (Pakistan time) on which they were signed in.
model ActivityDailySummary {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId    String    @map("employee_id") @db.Uuid
  day           DateTime  @db.Date
  /// The first moment the person was signed in that day (00:00 for a session carried over from the evening before).
  firstLoginAt  DateTime? @map("first_login_at") @db.Timestamptz(3)
  /// When the last session ended that day; for a session that stopped sending signals, its last signal.
  lastLogoutAt  DateTime? @map("last_logout_at") @db.Timestamptz(3)
  activeMinutes Int       @map("active_minutes")
  idleMinutes   Int       @map("idle_minutes")
  /// Recorded actions that day (creates, edits, approvals, sensitive views, exports...). Logins, logouts and screens are not counted.
  actions       Int
  /// Different tasks worked on that day. 0 until Module 5 registers its source (ActivityHooks.useTasksTouched).
  tasksTouched  Int       @default(0) @map("tasks_touched")
  /// The attendance check-in (Module 7). Null until Module 7 registers its source (ActivityHooks.useCheckIns).
  checkInAt     DateTime? @map("check_in_at") @db.Timestamptz(3)
  /// [{ from, to }] stretches of 5 minutes or more without mouse or keyboard use.
  idleSpans     Json      @default("[]") @map("idle_spans")
  sessions      Int
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([employeeId, day])
  @@index([day])
  @@map("activity_daily_summaries")
}

/// A security alert raised by a rule. The rule and the details never change; checking it adds a SecurityAlertCheck row.
model SecurityAlert {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind       AlertKind
  rule       String
  severity   AlertSeverity
  /// The person the alert is about.
  employeeId String        @map("employee_id") @db.Uuid
  occurredAt DateTime      @map("occurred_at") @db.Timestamptz(3)
  details    String
  data       Json?
  /// One alert per triggering event or time window: a retried rule can never raise it twice.
  dedupeKey  String        @unique @map("dedupe_key")
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  employee Employee            @relation("AlertSubject", fields: [employeeId], references: [id], onDelete: Restrict)
  check    SecurityAlertCheck?

  @@index([occurredAt])
  @@index([employeeId, kind, occurredAt])
  @@map("security_alerts")
}

/// "Marked as checked" by a reviewer, with a note. At most one per alert (unique), never changed.
model SecurityAlertCheck {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  alertId   String   @unique @map("alert_id") @db.Uuid
  checkedBy String   @map("checked_by") @db.Uuid
  note      String
  checkedAt DateTime @default(now()) @map("checked_at") @db.Timestamptz(3)

  alert   SecurityAlert @relation(fields: [alertId], references: [id], onDelete: Restrict)
  checker Employee      @relation("AlertChecker", fields: [checkedBy], references: [id], onDelete: Restrict)

  @@index([checkedAt])
  @@map("security_alert_checks")
}

// ---------------------------------------------------------------------------
// M5: task management (plan section 9). History tables are insert-only (a trigger blocks UPDATE and DELETE):
// task_history, task_reviews, task_size_setting_changes, task_comments, task_comment_mentions.
// A decided extension request can no longer change. Tasks are never deleted: they are cancelled.
// ---------------------------------------------------------------------------

/// The size table of plan section 9 (one row per size), editable by the Director. Old tasks keep the points and hours
/// they were created with (tasks.points and tasks.estimated_hours are copies), so changing a row never rewrites the past.
model TaskSizeSetting {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  size       TaskSize @unique
  meaning    String
  /// Estimated work in hours.
  hours      Decimal  @db.Decimal(6, 2)
  /// What the screens show, for example "2 to 4 h" or "1 to 2 days".
  hoursLabel String   @map("hours_label")
  points     Int
  /// Suggested working days for the deadline. Null for XL: it must be split before it is assigned.
  days       Int?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy  String?  @map("updated_by") @db.Uuid

  @@map("task_size_settings")
}

/// One line per change of the size table: the row before and after, who and why. Insert-only.
model TaskSizeSettingChange {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  size      TaskSize
  /// { meaning, hours, hoursLabel, points, days } before and after.
  before    Json
  after     Json
  reason    String
  changedBy String   @map("changed_by") @db.Uuid
  changedAt DateTime @default(now()) @map("changed_at") @db.Timestamptz(3)

  @@index([changedAt])
  @@index([size, changedAt])
  @@map("task_size_setting_changes")
}

/// Projects or clients a task can be linked to (so finance can show profit by project later). Minimal for now: read-only
/// demo rows; real projects and clients belong to a later module.
model Project {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code       String    @unique
  name       String
  client     String?
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy  String?   @map("created_by") @db.Uuid
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy  String?   @map("updated_by") @db.Uuid

  tasks       Task[]
  repeatRules TaskRepeatRule[]
  /// Module 14 project channels (back-relation only).
  channels    Conversation[]

  @@map("projects")
}

/// The company holiday calendar. Tasks skip these days when they suggest a deadline; Module 7 (attendance) and
/// Module 8 (payroll) read the same table. One holiday per date among the active rows: a partial unique index
/// ("holidays_active_date", in the migration) allows an archived row and a new active row on the same date.
model Holiday {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date       DateTime  @db.Date
  name       String
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy  String?   @map("created_by") @db.Uuid
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy  String?   @map("updated_by") @db.Uuid

  @@index([date])
  @@map("holidays")
}

/// A task: one owner, a size and a deadline. A personal to-do (personal = true) belongs to its owner alone: not scored,
/// not visible to managers, no review.
model Task {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// What people see: TSK-0001 for work tasks, TODO-0001 for personal to-dos. Generated by the service from a sequence.
  number           String       @unique
  title            String
  description      String       @default("")
  assigneeId       String       @map("assignee_id") @db.Uuid
  /// The person who assigned it (from the login). For a personal to-do: the owner.
  assignedById     String       @map("assigned_by_id") @db.Uuid
  projectId        String?      @map("project_id") @db.Uuid
  /// Link to a department goal (a later module owns goals): a plain reference, no table yet.
  goalId           String?      @map("goal_id")
  priority         TaskPriority @default(medium)
  size             TaskSize
  /// Copies of the size table's points and hours at the time the task was created.
  points           Int
  estimatedHours   Decimal      @map("estimated_hours") @db.Decimal(6, 2)
  startDate        DateTime     @map("start_date") @db.Timestamptz(3)
  /// The current deadline (changes when an extension is approved or the manager moves it).
  deadline         DateTime     @db.Timestamptz(3)
  /// The first deadline, never changed. On-time is measured against the approved (current) deadline.
  originalDeadline DateTime     @map("original_deadline") @db.Timestamptz(3)
  status           TaskStatus   @default(assigned)
  personal         Boolean      @default(false)
  /// When the person first started it (first move to in_progress). Null while not started (the "half time" reminder).
  startedAt        DateTime?    @map("started_at") @db.Timestamptz(3)
  /// The last time it was handed in for review.
  submittedAt      DateTime?    @map("submitted_at") @db.Timestamptz(3)
  /// When it was approved or cancelled.
  closedAt         DateTime?    @map("closed_at") @db.Timestamptz(3)
  extensionsCount  Int          @default(0) @map("extensions_count")
  reworkCount      Int          @default(0) @map("rework_count")
  /// Set on tasks created by a repeating series, with the day this one stands for. Unique together, so a retried job
  /// can never create the same occurrence twice.
  repeatRuleId     String?      @map("repeat_rule_id") @db.Uuid
  occurrenceOn     DateTime?    @map("occurrence_on") @db.Date
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy        String?      @map("created_by") @db.Uuid
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy        String?      @map("updated_by") @db.Uuid

  assignee   Employee        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  assignedBy Employee        @relation("TaskAssigner", fields: [assignedById], references: [id], onDelete: Restrict)
  project    Project?        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  repeatRule TaskRepeatRule? @relation(fields: [repeatRuleId], references: [id], onDelete: Restrict)

  checklist   TaskChecklistItem[]
  comments    TaskComment[]
  attachments TaskAttachment[]
  extensions  TaskExtension[]
  reviews     TaskReview[]
  history     TaskHistory[]
  scorecardTasks ScorecardTask[]
  /// Module 14 links (back-relations only).
  messageLinks   MessageTaskLink[]
  meetingLinks   MeetingTaskLink[]

  @@unique([repeatRuleId, occurrenceOn])
  @@index([assigneeId, status])
  @@index([assigneeId, deadline])
  @@index([assignedById, status])
  @@index([status, deadline])
  @@index([deadline])
  @@index([projectId])
  @@map("tasks")
}

/// Smaller steps inside a task. Ticked and unticked by the person doing the task.
model TaskChecklistItem {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId    String    @map("task_id") @db.Uuid
  position  Int
  text      String
  done      Boolean   @default(false)
  doneAt    DateTime? @map("done_at") @db.Timestamptz(3)
  doneBy    String?   @map("done_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy String?   @map("updated_by") @db.Uuid

  task Task @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@unique([taskId, position])
  @@index([doneBy, doneAt])
  @@map("task_checklist_items")
}

/// A comment on a task. Insert-only: comments are never edited or removed.
model TaskComment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  task        Task                 @relation(fields: [taskId], references: [id], onDelete: Restrict)
  author      Employee             @relation("TaskCommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  mentions    TaskCommentMention[]
  attachments TaskAttachment[]

  @@index([taskId, createdAt])
  @@index([authorId, createdAt])
  @@map("task_comments")
}

/// Who a comment @mentioned. Insert-only.
model TaskCommentMention {
  commentId  String   @map("comment_id") @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  comment  TaskComment @relation(fields: [commentId], references: [id], onDelete: Restrict)
  employee Employee    @relation("TaskMentioned", fields: [employeeId], references: [id], onDelete: Restrict)

  @@id([commentId, employeeId])
  @@index([employeeId])
  @@map("task_comment_mentions")
}

/// A file on a task or on one of its comments. The file lives in private storage (FileStorage) under storage_key; this
/// table never holds file bytes or public links. Archived, never deleted.
model TaskAttachment {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId           String    @map("task_id") @db.Uuid
  /// Set when the file was added with a comment.
  commentId        String?   @map("comment_id") @db.Uuid
  uploadedById     String    @map("uploaded_by_id") @db.Uuid
  storageKey       String    @unique @map("storage_key")
  originalFilename String    @map("original_filename")
  mimeType         String    @map("mime_type")
  sizeBytes        Int       @map("size_bytes")
  sha256           String
  archivedAt       DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy        String?   @map("updated_by") @db.Uuid

  task       Task         @relation(fields: [taskId], references: [id], onDelete: Restrict)
  comment    TaskComment? @relation(fields: [commentId], references: [id], onDelete: Restrict)
  uploadedBy Employee     @relation("TaskAttachmentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([taskId])
  @@index([commentId])
  @@index([uploadedById, createdAt])
  @@map("task_attachments")
}

/// A request for more time. A request before the deadline is on time; after it the request is "late". The assigner
/// decides. One pending request per task (partial unique index). Once decided the row never changes (trigger).
model TaskExtension {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId            String          @map("task_id") @db.Uuid
  requestedById     String          @map("requested_by_id") @db.Uuid
  /// The deadline when the request was made, and the one asked for.
  currentDeadline   DateTime        @map("current_deadline") @db.Timestamptz(3)
  requestedDeadline DateTime        @map("requested_deadline") @db.Timestamptz(3)
  reason            String
  status            ExtensionStatus @default(pending)
  /// Asked after the deadline: counts as late.
  late              Boolean         @default(false)
  decidedById       String?         @map("decided_by_id") @db.Uuid
  decidedAt         DateTime?       @map("decided_at") @db.Timestamptz(3)
  /// Required when rejecting.
  decisionReason    String?         @map("decision_reason")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  task        Task      @relation(fields: [taskId], references: [id], onDelete: Restrict)
  requestedBy Employee  @relation("ExtensionRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy   Employee? @relation("ExtensionDecider", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
  @@index([status, createdAt])
  @@index([requestedById, createdAt])
  @@index([decidedById, decidedAt])
  @@map("task_extensions")
}

/// The review of a submitted task: approved with a rating 1 to 5 (and an optional comment) or sent back with a reason.
/// Insert-only. Module 6 builds the performance figures on top of it; a later rating change (a dispute) adds its own
/// row in Module 6, it never edits this one.
model TaskReview {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId           String         @map("task_id") @db.Uuid
  reviewerId       String         @map("reviewer_id") @db.Uuid
  decision         ReviewDecision
  /// 1 to 5 on approve, null on rework.
  rating           Int?
  /// The approve comment (optional).
  comment          String?
  /// The rework reason (required on rework).
  reason           String?
  /// When the task was handed in, and the deadline in force at that moment (so on-time can be worked out later).
  submittedAt      DateTime?      @map("submitted_at") @db.Timestamptz(3)
  deadlineAtReview DateTime       @map("deadline_at_review") @db.Timestamptz(3)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  task     Task     @relation(fields: [taskId], references: [id], onDelete: Restrict)
  reviewer Employee @relation("TaskReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
  @@index([reviewerId, createdAt])
  @@map("task_reviews")
}

/// The full history of a task: creation, every status change, deadline changes, extensions, hand-overs. Insert-only.
/// by_id is null for the system (a repeating series, the leaver hand-over, an automatic job).
model TaskHistory {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId     String          @map("task_id") @db.Uuid
  kind       TaskHistoryKind @default(status)
  fromStatus TaskStatus?     @map("from_status")
  toStatus   TaskStatus      @map("to_status")
  byId       String?         @map("by_id") @db.Uuid
  reason     String?
  /// Small extras: { fromDeadline, toDeadline } for a deadline change, { fromEmpId, toEmpId } for a hand-over...
  details    Json?
  at         DateTime        @default(now()) @db.Timestamptz(3)

  task Task      @relation(fields: [taskId], references: [id], onDelete: Restrict)
  by   Employee? @relation("TaskHistoryActor", fields: [byId], references: [id], onDelete: Restrict)

  @@index([taskId, at])
  @@index([byId, at])
  @@index([at])
  @@map("task_history")
}

/// A repeating task (for example a weekly report every Monday). It keeps its own copy of what to create; the job
/// "task.repeat" creates one task per due day and arms itself for the next. It repeats until the stop date or until
/// someone stops it. Tasks it created point back to it (tasks.repeat_rule_id).
model TaskRepeatRule {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  every            RepeatUnit
  /// Weekly: 1 = Monday ... 7 = Sunday. Monthly: day of the month 1 to 28.
  on               Int
  /// Stop date (Pakistan day, included). Null = until stopped.
  until            DateTime?    @db.Date
  active           Boolean      @default(true)
  stoppedAt        DateTime?    @map("stopped_at") @db.Timestamptz(3)
  stoppedBy        String?      @map("stopped_by") @db.Uuid
  /// The last occurrence day a task was created for. Starts as the Pakistan day of the task that began the series.
  lastOccurrenceOn DateTime?    @map("last_occurrence_on") @db.Date
  /// What each new task copies.
  title            String
  description      String       @default("")
  assigneeId       String       @map("assignee_id") @db.Uuid
  assignedById     String       @map("assigned_by_id") @db.Uuid
  projectId        String?      @map("project_id") @db.Uuid
  priority         TaskPriority
  size             TaskSize
  estimatedHours   Decimal      @map("estimated_hours") @db.Decimal(6, 2)
  /// The start time of day in Pakistan time ("09:00") and how long each task runs (deadline minus start).
  startTime        String       @map("start_time")
  durationMinutes  Int          @map("duration_minutes")
  /// The checklist texts to copy: ["Write the report", "Send it"].
  checklist        Json         @default("[]")
  personal         Boolean      @default(false)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy        String?      @map("created_by") @db.Uuid
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy        String?      @map("updated_by") @db.Uuid

  project Project? @relation(fields: [projectId], references: [id], onDelete: Restrict)
  tasks   Task[]

  @@index([active, every])
  @@map("task_repeat_rules")
}

/// A set of score weights (plan section 10). INSERT-ONLY: a change of weights is a NEW version, old scorecards keep the
/// version they were made with. `weights` are WHOLE percentages that add up to exactly 100 (checked in the database),
/// by metric key: standard = quality, onTime, completion, rework, attendance; sales = activity, meetings, won,
/// dataQuality, attendance. department_id null = the company-wide set of that kind; set = that department's own set,
/// which wins for its people. The starting versions (standard 35/25/20/10/10, sales 20/25/30/10/15) come with the migration.
model ScoreWeightVersion {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind          ScorecardKind
  departmentId  String?       @map("department_id") @db.Uuid
  /// 1, 2, 3 ... counted per kind and department (the label is "Standard v2").
  versionNo     Int           @map("version_no")
  weights       Json
  /// Why the Director changed it (the starting versions carry a short note).
  note          String?
  effectiveFrom DateTime      @default(now()) @map("effective_from") @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Null for the starting versions the migration inserts.
  createdById   String?       @map("created_by") @db.Uuid

  department Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  createdBy  Employee?   @relation("WeightVersionAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  scorecards Scorecard[]

  @@index([kind, departmentId, effectiveFrom])
  @@map("score_weight_versions")
}

/// One person's monthly scorecard (unique per person and month). Created as a draft by the monthly job from the month's
/// tasks (and attendance and sales figures once their modules exist); nobody types a number in.
///
/// THE NUMBERS NEVER CHANGE: metrics, score, band, the weights version, the task count and the sales figures are
/// frozen by the database trigger `scorecards_protect`. The one exception is the recompute after a dispute decision
/// that changed a rating: the numbers may change only together with recompute_count going up by one while the person
/// has more "changed" disputes than recomputes (see the migration). Release and acknowledge only move status forward.
/// metrics: each of the five metrics 0 to 100, or null = not measured (then its weight is shared among the measured
/// ones); workloadHours (standard only) is information. unmeasured: [{ key, reason }]. Score and band are null when
/// nothing could be measured. A draft without a reviewer (the Director's) is released by the system straight away.
model Scorecard {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId       String          @map("employee_id") @db.Uuid
  /// "2026-10": the month the scorecard is about (Pakistan time).
  month            String          @db.VarChar(7)
  kind             ScorecardKind
  weightsVersionId String          @map("weights_version_id") @db.Uuid
  metrics          Json
  /// The raw sales figures behind a sales scorecard (Module 15). Null while that module does not exist.
  salesDetail      Json?           @map("sales_detail")
  unmeasured       Json            @default("[]")
  score            Decimal?        @db.Decimal(4, 1)
  band             ScorecardBand?
  taskCount        Int             @map("task_count")
  smallSample      Boolean         @map("small_sample")
  status           ScorecardStatus @default(draft)
  /// Who reviews and releases it (the person's manager, one level further up if the manager left). Null = nobody does
  /// (the Director: the CEO / Founder / Owner reviews nothing), so the system releases it.
  reviewerId       String?         @map("reviewer_id") @db.Uuid
  releasedAt       DateTime?       @map("released_at") @db.Timestamptz(3)
  /// Null when the system released it (no reviewer).
  releasedById     String?         @map("released_by") @db.Uuid
  acknowledgedAt   DateTime?       @map("acknowledged_at") @db.Timestamptz(3)
  /// How often the numbers were recomputed after a dispute decision (equals the number of "changed" disputes applied).
  recomputeCount   Int             @default(0) @map("recompute_count")
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  employee       Employee           @relation("ScorecardOwner", fields: [employeeId], references: [id], onDelete: Restrict)
  reviewer       Employee?          @relation("ScorecardReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  releasedBy     Employee?          @relation("ScorecardReleaser", fields: [releasedById], references: [id], onDelete: Restrict)
  weightsVersion ScoreWeightVersion @relation(fields: [weightsVersionId], references: [id], onDelete: Restrict)
  tasks          ScorecardTask[]
  comments       ScorecardComment[]
  disputes       RatingDispute[]

  @@unique([employeeId, month])
  @@index([reviewerId, status])
  @@index([status, month])
  @@index([month])
  @@map("scorecards")
}

/// The tasks a scorecard was made from, copied when it was made so it never changes when a task changes later
/// (INSERT-ONLY). `rating` is the rating at that moment; a dispute that changed it is on rating_disputes.
/// counted = this task was part of the metrics (not cancelled, and already due or handed in).
model ScorecardTask {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scorecardId String              @map("scorecard_id") @db.Uuid
  taskId      String              @map("task_id") @db.Uuid
  position    Int
  number      String
  title       String
  size        TaskSize
  points      Int
  rating      Int?
  onTime      Boolean             @map("on_time")
  reworked    Boolean
  extensions  Int
  status      ScorecardTaskStatus
  counted     Boolean
  deadline    DateTime            @db.Timestamptz(3)

  scorecard Scorecard       @relation(fields: [scorecardId], references: [id], onDelete: Restrict)
  task      Task            @relation(fields: [taskId], references: [id], onDelete: Restrict)
  disputes  RatingDispute[]

  @@unique([scorecardId, taskId])
  @@index([taskId])
  @@map("scorecard_tasks")
}

/// The history of remarks and comments on a scorecard (INSERT-ONLY): the reviewer's remarks (several are possible, the
/// newest is shown) and the employee's comment on acknowledging.
model ScorecardComment {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scorecardId String               @map("scorecard_id") @db.Uuid
  kind        ScorecardCommentKind
  authorId    String               @map("author_id") @db.Uuid
  body        String
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  scorecard Scorecard @relation(fields: [scorecardId], references: [id], onDelete: Restrict)
  author    Employee  @relation("ScorecardCommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([scorecardId, createdAt])
  @@map("scorecard_comments")
}

/// An employee disagrees with the rating of one task on their released scorecard. One OPEN dispute per task. The
/// decider (the level above the task's reviewer who reviews work; never the employee) either upholds the rating or
/// changes it to a new one. A decided dispute never changes and is never deleted: it IS the rating-change history
/// (old rating, new rating, who, why, the score before and after).
model RatingDispute {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scorecardId   String        @map("scorecard_id") @db.Uuid
  taskId        String        @map("task_id") @db.Uuid
  employeeId    String        @map("employee_id") @db.Uuid
  reason        String
  /// The rating the task had when the dispute was raised (the original, or the one a previous dispute set).
  ratingAtRaise Int           @map("rating_at_raise")
  /// Who must decide, worked out when it was raised.
  deciderId     String        @map("decider_id") @db.Uuid
  status        DisputeStatus @default(open)
  decidedById   String?       @map("decided_by") @db.Uuid
  decision      String?
  /// Only when the rating was changed.
  newRating     Int?          @map("new_rating")
  decidedAt     DateTime?     @map("decided_at") @db.Timestamptz(3)
  /// Only when changed: the scorecard's score and metrics before and after the recompute.
  scoreBefore   Decimal?      @map("score_before") @db.Decimal(4, 1)
  scoreAfter    Decimal?      @map("score_after") @db.Decimal(4, 1)
  metricsBefore Json?         @map("metrics_before")
  metricsAfter  Json?         @map("metrics_after")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  scorecard     Scorecard     @relation(fields: [scorecardId], references: [id], onDelete: Restrict)
  scorecardTask ScorecardTask @relation(fields: [scorecardId, taskId], references: [scorecardId, taskId], onDelete: Restrict)
  employee      Employee      @relation("DisputeRaiser", fields: [employeeId], references: [id], onDelete: Restrict)
  decider       Employee      @relation("DisputeDecider", fields: [deciderId], references: [id], onDelete: Restrict)
  decidedBy     Employee?     @relation("DisputeDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([scorecardId, status])
  @@index([deciderId, status, createdAt])
  @@index([employeeId, createdAt])
  @@index([status, createdAt])
  @@map("rating_disputes")
}

/// Temporary PostgreSQL-backed job queue (BullMQ replaces it once Redis exists).
/// dedupe_key prevents duplicate jobs; locked_at/locked_by prevent double execution;
/// attempts/max_attempts/last_error give retries and failure logging; a job left "running"
/// after a restart is picked up again once its lock is stale.
model ScheduledJob {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type        String
  dedupeKey   String    @unique @map("dedupe_key")
  payload     Json
  runAt       DateTime  @map("run_at") @db.Timestamptz(3)
  status      JobStatus @default(pending)
  attempts    Int       @default(0)
  maxAttempts Int       @default(5) @map("max_attempts")
  lockedAt    DateTime? @map("locked_at") @db.Timestamptz(3)
  lockedBy    String?   @map("locked_by")
  lastError   String?   @map("last_error")
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy   String?   @map("created_by") @db.Uuid
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy   String?   @map("updated_by") @db.Uuid

  @@index([status, runAt])
  @@map("scheduled_jobs")
}

/// HR starts a hire; only the Director authorizes the level and reporting line, and may also hire directly (decision M3-3).
/// Nothing exists as an employee (no Emp-ID, no login) until it is approved. Personal and pay details wait here encrypted.
model HireRequest {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status              HireRequestStatus @default(pending)
  name                String
  designation         String
  departmentCode      String            @map("department_code")
  officeCode          String            @map("office_code")
  officialEmail       String            @map("official_email")
  joiningDate         DateTime          @map("joining_date") @db.Date
  employmentType      EmploymentType    @map("employment_type")
  weeklyCapacityHours Int?              @map("weekly_capacity_hours")
  proposedLevel       Int               @map("proposed_level")
  proposedReportsTo   String            @map("proposed_reports_to")
  /// Encrypted JSON: personal and pay details entered by the requester.
  sensitiveEncrypted  String?           @map("sensitive_encrypted")
  requestedBy         String            @map("requested_by") @db.Uuid
  requestedAt         DateTime          @default(now()) @map("requested_at") @db.Timestamptz(3)
  decidedBy           String?           @map("decided_by") @db.Uuid
  decidedAt           DateTime?         @map("decided_at") @db.Timestamptz(3)
  decisionReason      String?           @map("decision_reason")
  employeeId          String?           @unique @map("employee_id") @db.Uuid
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  requester Employee  @relation("HireRequester", fields: [requestedBy], references: [id])
  decider   Employee? @relation("HireDecider", fields: [decidedBy], references: [id])
  employee  Employee? @relation("HireResult", fields: [employeeId], references: [id])

  @@index([status, requestedAt])
  @@map("hire_requests")
}

// ===========================================================================
// Cycle 3 shared foundation: M7 attendance and leave, M8 payroll, M9 finance ledger.
// Schema owner: Track A. Module tracks request changes; they do not edit this file.
//   * Months are 'YYYY-MM' text (CHECK in the migration). Calendar days are @db.Date in Pakistan local time.
//   * Money is NUMERIC(..,2). Exchange rates NUMERIC(18,6). Tax rates NUMERIC(7,4).
//   * Actor columns (decided_by, approved_by...) hold employee UUIDs without a foreign key, like created_by.
// ===========================================================================

enum LeaveRequestStatus {
  pending_manager
  pending_director
  approved
  rejected
  cancelled

  @@map("leave_request_status")
}

enum CorrectionStatus {
  pending
  approved
  rejected
  cancelled

  @@map("correction_status")
}

enum PayrollStage {
  draft
  calculated
  prepared
  reviewed
  approved

  @@map("payroll_stage")
}

enum PayrollItemKind {
  bonus
  deduction

  @@map("payroll_item_kind")
}

enum PayrollItemSource {
  manual
  commission
  adjustment

  @@map("payroll_item_source")
}

enum AdvanceStatus {
  pending_payout
  active
  repaid
  cancelled

  @@map("advance_status")
}

enum AccountGroup {
  asset
  liability
  equity
  income
  expense

  @@map("account_group")
}

enum Currency {
  PKR
  USD

  @@map("currency")
}

enum JournalEntryStatus {
  draft
  pending_approval
  posted
  rejected

  @@map("journal_entry_status")
}

enum JournalSource {
  manual
  invoice
  bill
  payment
  transfer
  payroll
  payroll_payment
  advance
  reversal
  revaluation
  opening

  @@map("journal_source")
}

enum PartyKind {
  client
  vendor

  @@map("party_kind")
}

enum PaymentDirection {
  received
  made

  @@map("payment_direction")
}

enum FinancePeriodStatus {
  open
  closing
  closed

  @@map("finance_period_status")
}

// ---------------------------------------------------------------------------
// M7: attendance and leave (Track A)
// ---------------------------------------------------------------------------

/// Working hours and grace period. The row in force on a day is the latest effective_from <= that day.
/// Values are settings (plan section 11); the seeded row is a development default only.
model WorkSchedule {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  effectiveFrom     DateTime @unique @map("effective_from") @db.Date
  /// Minutes after midnight, Pakistan time.
  startMinute       Int      @map("start_minute")
  endMinute         Int      @map("end_minute")
  graceMinutes      Int      @map("grace_minutes")
  /// ISO weekdays that are working days (1 = Monday ... 7 = Sunday).
  workingWeekdays   Int[]    @map("working_weekdays")
  /// Office staff may check in only from their office network (management decides; off by default).
  officeOnlyCheckIn Boolean  @default(false) @map("office_only_check_in")
  note              String?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy         String?  @map("created_by") @db.Uuid
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy         String?  @map("updated_by") @db.Uuid

  @@map("work_schedules")
}

/// Office internet connections for the optional office-only check-in. An office with no rows (for example Remote) is not restricted.
model OfficeNetwork {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  officeId   String    @map("office_id") @db.Uuid
  /// An IPv4 address or CIDR range.
  cidr       String
  label      String?
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy  String?   @map("created_by") @db.Uuid
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy  String?   @map("updated_by") @db.Uuid

  @@index([officeId])
  @@map("office_networks")
}

/// One working day of one employee. check_in_at / check_out_at are the ORIGINAL server times and never change;
/// an approved correction is applied through corrected_* so the original is always kept (plan section 11).
model AttendanceRecord {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId          String    @map("employee_id") @db.Uuid
  /// The calendar day in Pakistan time.
  workDate            DateTime  @map("work_date") @db.Date
  checkInAt           DateTime? @map("check_in_at") @db.Timestamptz(3)
  checkOutAt          DateTime? @map("check_out_at") @db.Timestamptz(3)
  checkInIp           String?   @map("check_in_ip")
  checkOutIp          String?   @map("check_out_ip")
  /// Minutes after start + grace (0 = on time). Recomputed when a correction is approved.
  lateMinutes         Int       @default(0) @map("late_minutes")
  /// The system closed the day at the end of working hours because nobody checked out.
  missedCheckout      Boolean   @default(false) @map("missed_checkout")
  autoClosedAt        DateTime? @map("auto_closed_at") @db.Timestamptz(3)
  correctedCheckInAt  DateTime? @map("corrected_check_in_at") @db.Timestamptz(3)
  correctedCheckOutAt DateTime? @map("corrected_check_out_at") @db.Timestamptz(3)
  scheduleId          String?   @map("schedule_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy           String?   @map("created_by") @db.Uuid
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy           String?   @map("updated_by") @db.Uuid

  employee    Employee               @relation(fields: [employeeId], references: [id])
  corrections AttendanceCorrection[]

  @@unique([employeeId, workDate])
  @@index([workDate])
  @@map("attendance_records")
}

/// A request to fix a wrong or missed entry. The original record is kept unchanged.
model AttendanceCorrection {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId          String           @map("employee_id") @db.Uuid
  workDate            DateTime         @map("work_date") @db.Date
  recordId            String?          @map("record_id") @db.Uuid
  requestedCheckInAt  DateTime?        @map("requested_check_in_at") @db.Timestamptz(3)
  requestedCheckOutAt DateTime?        @map("requested_check_out_at") @db.Timestamptz(3)
  reason              String
  status              CorrectionStatus @default(pending)
  decidedBy           String?          @map("decided_by") @db.Uuid
  decidedAt           DateTime?        @map("decided_at") @db.Timestamptz(3)
  decisionNote        String?          @map("decision_note")
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy           String?          @map("created_by") @db.Uuid
  updatedAt           DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy           String?          @map("updated_by") @db.Uuid

  employee Employee          @relation(fields: [employeeId], references: [id])
  record   AttendanceRecord? @relation(fields: [recordId], references: [id])

  @@index([employeeId, workDate])
  @@index([status])
  @@map("attendance_corrections")
}

/// Leave types (casual, sick, annual, unpaid...). Set in settings; the seeded rows are development defaults only.
model LeaveType {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key        String    @unique
  name       String
  /// Days per leave year. Null = no yearly limit (for example unpaid leave).
  yearlyDays Decimal?  @map("yearly_days") @db.Decimal(5, 1)
  /// Unpaid leave days are passed to payroll at month end.
  paid       Boolean   @default(true)
  color      String?
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy  String?   @map("created_by") @db.Uuid
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy  String?   @map("updated_by") @db.Uuid

  entitlements LeaveEntitlement[]
  requests     LeaveRequest[]

  @@map("leave_types")
}

/// A person's yearly allowance for one leave type when it differs from the type's default. Used and pending days are
/// always calculated from the requests, so the balance can never drift.
model LeaveEntitlement {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId  String   @map("employee_id") @db.Uuid
  leaveTypeId String   @map("leave_type_id") @db.Uuid
  year        Int
  days        Decimal  @db.Decimal(5, 1)
  reason      String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy   String?  @map("created_by") @db.Uuid
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy   String?  @map("updated_by") @db.Uuid

  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, year])
  @@map("leave_entitlements")
}

model LeaveRequest {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// LV-2026-0001, from a database sequence.
  number      String             @unique @default(dbgenerated("((('LV-'::text || to_char(now(), 'YYYY'::text)) || '-'::text) || lpad((nextval('leave_request_seq'::regclass))::text, 4, '0'::text))"))
  employeeId  String             @map("employee_id") @db.Uuid
  leaveTypeId String             @map("leave_type_id") @db.Uuid
  fromDate    DateTime           @map("from_date") @db.Date
  toDate      DateTime           @map("to_date") @db.Date
  halfDay     Boolean            @default(false) @map("half_day")
  /// Working days counted (weekends and holidays excluded), 0.5 for a half day.
  days        Decimal            @db.Decimal(5, 1)
  reason      String
  status      LeaveRequestStatus @default(pending_manager)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy   String?            @map("created_by") @db.Uuid
  updatedAt   DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy   String?            @map("updated_by") @db.Uuid

  employee  Employee        @relation(fields: [employeeId], references: [id])
  leaveType LeaveType       @relation(fields: [leaveTypeId], references: [id])
  decisions LeaveDecision[]

  @@index([employeeId, fromDate])
  @@index([status])
  @@map("leave_requests")
}

/// Each approval step decision. Insert-only.
model LeaveDecision {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId String   @map("request_id") @db.Uuid
  step      Int
  /// approved | rejected | cancelled
  decision  String
  decidedBy String   @map("decided_by") @db.Uuid
  /// 'manager' or 'stand_in' (from Module 1 routing), or 'self' for a cancellation
  via       String?
  note      String?
  decidedAt DateTime @default(now()) @map("decided_at") @db.Timestamptz(3)

  request LeaveRequest @relation(fields: [requestId], references: [id])

  @@index([requestId])
  @@map("leave_decisions")
}

/// Month lock: once a month is locked (payroll calculation), attendance and leave dated in it cannot change.
model AttendancePeriod {
  month     String   @id
  lockedAt  DateTime @default(now()) @map("locked_at") @db.Timestamptz(3)
  lockedBy  String?  @map("locked_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("attendance_periods")
}

// ---------------------------------------------------------------------------
// M8: payroll (Track B)
// ---------------------------------------------------------------------------

/// A version of the income tax slabs. Runs keep the version they were calculated with. Never edited: a change is a new version.
model TaxSlabSet {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  effectiveFrom DateTime @map("effective_from") @db.Date
  label         String
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy     String?  @map("created_by") @db.Uuid

  slabs TaxSlab[]
  runs  PayrollRun[]

  @@index([effectiveFrom])
  @@map("tax_slab_sets")
}

/// Yearly taxable income from..to: tax = fixed + (income - from) x rate.
model TaxSlab {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  setId       String   @map("set_id") @db.Uuid
  fromAmount  Decimal  @map("from_amount") @db.Decimal(14, 2)
  /// Null = no upper limit.
  toAmount    Decimal? @map("to_amount") @db.Decimal(14, 2)
  fixedAmount Decimal  @map("fixed_amount") @db.Decimal(14, 2)
  rate        Decimal  @db.Decimal(7, 4)

  set TaxSlabSet @relation(fields: [setId], references: [id])

  @@index([setId])
  @@map("tax_slabs")
}

model PayrollRun {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// PR-2026-11
  number            String       @unique
  month             String       @unique
  stage             PayrollStage @default(draft)
  workingDays       Int?         @map("working_days")
  taxSlabSetId      String?      @map("tax_slab_set_id") @db.Uuid
  calculatedAt      DateTime?    @map("calculated_at") @db.Timestamptz(3)
  preparedBy        String?      @map("prepared_by") @db.Uuid
  preparedAt        DateTime?    @map("prepared_at") @db.Timestamptz(3)
  reviewedBy        String?      @map("reviewed_by") @db.Uuid
  reviewedAt        DateTime?    @map("reviewed_at") @db.Timestamptz(3)
  approvedBy        String?      @map("approved_by") @db.Uuid
  approvedAt        DateTime?    @map("approved_at") @db.Timestamptz(3)
  returnedNote      String?      @map("returned_note")
  /// The salary journal entry in Module 9 (created on approval).
  journalEntryId    String?      @unique @map("journal_entry_id") @db.Uuid
  /// The payment journal entry that clears salary payable (bank transfer made).
  paymentEntryId    String?      @unique @map("payment_entry_id") @db.Uuid
  paymentRecordedAt DateTime?    @map("payment_recorded_at") @db.Timestamptz(3)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy         String?      @map("created_by") @db.Uuid
  updatedAt         DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy         String?      @map("updated_by") @db.Uuid

  taxSlabSet TaxSlabSet?   @relation(fields: [taxSlabSetId], references: [id])
  lines      PayrollLine[]
  items      PayrollItem[]
  payslips   Payslip[]

  @@map("payroll_runs")
}

/// One employee's salary in one run. Amounts are a snapshot taken at calculation; an approved run's lines never change.
model PayrollLine {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId            String   @map("run_id") @db.Uuid
  employeeId       String   @map("employee_id") @db.Uuid
  baseSalary       Decimal  @map("base_salary") @db.Decimal(12, 2)
  allowances       Decimal  @db.Decimal(12, 2)
  bonus            Decimal  @default(0) @db.Decimal(12, 2)
  unpaidDays       Decimal  @default(0) @map("unpaid_days") @db.Decimal(5, 1)
  unpaidDeduction  Decimal  @default(0) @map("unpaid_deduction") @db.Decimal(12, 2)
  taxableIncome    Decimal  @default(0) @map("taxable_income") @db.Decimal(12, 2)
  tax              Decimal  @default(0) @db.Decimal(12, 2)
  advanceDeduction Decimal  @default(0) @map("advance_deduction") @db.Decimal(12, 2)
  otherDeductions  Decimal  @default(0) @map("other_deductions") @db.Decimal(12, 2)
  net              Decimal  @db.Decimal(12, 2)
  /// Attendance facts for information (plan: only unpaid leave is deducted).
  workingDays      Int      @map("working_days")
  presentDays      Int      @default(0) @map("present_days")
  lateDays         Int      @default(0) @map("late_days")
  absentDays       Int      @default(0) @map("absent_days")
  /// Things a person must look at (joined or left during the month, no pay on file...). JSON array of codes.
  flags            Json     @default("[]")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  run      PayrollRun @relation(fields: [runId], references: [id])
  employee Employee   @relation(fields: [employeeId], references: [id])
  payslip  Payslip?

  @@unique([runId, employeeId])
  @@index([employeeId])
  @@map("payroll_lines")
}

/// Bonus or deduction lines added to a run before it is prepared (commission arrives here later from M15).
model PayrollItem {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId        String            @map("run_id") @db.Uuid
  employeeId   String            @map("employee_id") @db.Uuid
  kind         PayrollItemKind
  source       PayrollItemSource @default(manual)
  label        String
  amount       Decimal           @db.Decimal(12, 2)
  adjustmentId String?           @unique @map("adjustment_id") @db.Uuid
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy    String?           @map("created_by") @db.Uuid

  run        PayrollRun         @relation(fields: [runId], references: [id])
  employee   Employee           @relation(fields: [employeeId], references: [id])
  adjustment PayrollAdjustment? @relation(fields: [adjustmentId], references: [id])

  @@index([runId, employeeId])
  @@map("payroll_items")
}

/// A fix for a mistake found after approval: applied in a later month's run, never by editing the approved run.
model PayrollAdjustment {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId  String          @map("employee_id") @db.Uuid
  /// The month whose run must include it.
  targetMonth String          @map("target_month")
  originRunId String?         @map("origin_run_id") @db.Uuid
  kind        PayrollItemKind
  amount      Decimal         @db.Decimal(12, 2)
  reason      String
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy   String?         @map("created_by") @db.Uuid

  employee Employee     @relation(fields: [employeeId], references: [id])
  item     PayrollItem?

  @@index([targetMonth])
  @@map("payroll_adjustments")
}

model SalaryAdvance {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId       String        @map("employee_id") @db.Uuid
  amount           Decimal       @db.Decimal(12, 2)
  monthlyDeduction Decimal       @map("monthly_deduction") @db.Decimal(12, 2)
  /// First month whose payroll deducts a repayment.
  startMonth       String        @map("start_month")
  status           AdvanceStatus @default(pending_payout)
  reason           String
  /// The payout journal entry (Dr employee advances / Cr bank) in Module 9.
  payoutEntryId    String?       @unique @map("payout_entry_id") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy        String?       @map("created_by") @db.Uuid
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy        String?       @map("updated_by") @db.Uuid

  employee   Employee           @relation(fields: [employeeId], references: [id])
  repayments AdvanceRepayment[]

  @@index([employeeId, status])
  @@map("salary_advances")
}

/// A repayment taken by an approved payroll run. Insert-only.
model AdvanceRepayment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  advanceId String   @map("advance_id") @db.Uuid
  runId     String   @map("run_id") @db.Uuid
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  advance SalaryAdvance @relation(fields: [advanceId], references: [id])

  @@unique([advanceId, runId])
  @@map("advance_repayments")
}

/// The payslip issued for one payroll line when the run is approved.
model Payslip {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId      String   @map("run_id") @db.Uuid
  lineId     String   @unique @map("line_id") @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  month      String
  /// Private storage key of the generated document, when one has been generated.
  storageKey String?  @unique @map("storage_key")
  sha256     String?
  issuedAt   DateTime @default(now()) @map("issued_at") @db.Timestamptz(3)

  run      PayrollRun  @relation(fields: [runId], references: [id])
  line     PayrollLine @relation(fields: [lineId], references: [id])
  employee Employee    @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, month])
  @@map("payslips")
}

/// Final salary for a leaver, created from the M3 event payroll.final_settlement.requested.
model FinalSettlement {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId     String    @unique @map("employee_id") @db.Uuid
  lastWorkingDay DateTime  @map("last_working_day") @db.Date
  /// The outbox event that asked for it (duplicates are ignored).
  sourceEventId  String    @unique @map("source_event_id") @db.Uuid
  runId          String?   @map("run_id") @db.Uuid
  settledAt      DateTime? @map("settled_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("final_settlements")
}

// ---------------------------------------------------------------------------
// M9: finance ledger (Track C)
// ---------------------------------------------------------------------------

/// Chart of accounts: 1000 assets, 2000 liabilities, 3000 equity, 4000 income, 5000 expenses.
model LedgerAccount {
  id                    String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                  String       @unique
  name                  String
  group                 AccountGroup @map("account_group")
  parentId              String?      @map("parent_id") @db.Uuid
  currency              Currency     @default(PKR)
  isBank                Boolean      @default(false) @map("is_bank")
  /// Share capital and loan accounts: every entry touching them needs the Owner (plan section 13).
  requiresOwnerApproval Boolean      @default(false) @map("requires_owner_approval")
  /// Feeds other comprehensive income (the accountant confirms which, plan section 14).
  isOci                 Boolean      @default(false) @map("is_oci")
  /// A system role used by automatic postings, e.g. salary_expense, salary_payable, tax_payable, employee_advances.
  systemRole            String?      @unique @map("system_role")
  archivedAt            DateTime?    @map("archived_at") @db.Timestamptz(3)
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy             String?      @map("created_by") @db.Uuid
  updatedAt             DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy             String?      @map("updated_by") @db.Uuid

  parent   LedgerAccount?     @relation("AccountParent", fields: [parentId], references: [id])
  children LedgerAccount[]    @relation("AccountParent")
  lines    JournalLine[]
  bank     BankAccountDetail?

  @@index([group])
  @@map("ledger_accounts")
}

/// Bank details for a bank ledger account. The account number is encrypted and shown masked.
model BankAccountDetail {
  accountId              String   @id @map("account_id") @db.Uuid
  bankName               String   @map("bank_name")
  accountNumberEncrypted String   @map("account_number_encrypted")
  accountNumberLast4     String   @map("account_number_last4")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy              String?  @map("created_by") @db.Uuid
  updatedAt              DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy              String?  @map("updated_by") @db.Uuid

  account LedgerAccount @relation(fields: [accountId], references: [id])

  @@map("bank_account_details")
}

model Party {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind       PartyKind
  name       String
  email      String?
  phone      String?
  country    String?
  address    String?
  currency   Currency  @default(PKR)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy  String?   @map("created_by") @db.Uuid
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy  String?   @map("updated_by") @db.Uuid

  lines          JournalLine[]
  invoices       Invoice[]
  bills          Bill[]
  payments       Payment[]
  billingProfile BillingProfile?
  recurringRules RecurringBillingRule[]
  salesCompanies SalesCompany[]

  @@index([kind, name])
  @@map("parties")
}

/// Projects for tagging entries (profit by project). Minimal list owned by M9 until a projects module exists.
model FinanceProject {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code       String    @unique
  name       String
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy  String?   @map("created_by") @db.Uuid
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy  String?   @map("updated_by") @db.Uuid

  entries JournalEntry[]

  @@map("finance_projects")
}

/// One USD rate per day (PKR per 1 USD). Saved again on every USD entry.
model ExchangeRate {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  currency  Currency
  rateDate  DateTime @map("rate_date") @db.Date
  rate      Decimal  @db.Decimal(18, 6)
  source    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid

  @@unique([currency, rateDate])
  @@map("exchange_rates")
}

model FinancePeriod {
  /// 'YYYY-MM'
  month            String              @id
  status           FinancePeriodStatus @default(open)
  checklist        Json?
  closeRequestedBy String?             @map("close_requested_by") @db.Uuid
  closeRequestedAt DateTime?           @map("close_requested_at") @db.Timestamptz(3)
  closedBy         String?             @map("closed_by") @db.Uuid
  closedAt         DateTime?           @map("closed_at") @db.Timestamptz(3)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy        String?             @map("updated_by") @db.Uuid

  events FinancePeriodEvent[]

  @@map("finance_periods")
}

/// Close requested, approved, rejected, reopened (with reason). Insert-only.
model FinancePeriodEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  month     String
  action    String
  actorId   String   @map("actor_id") @db.Uuid
  reason    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  period FinancePeriod @relation(fields: [month], references: [month])

  @@index([month])
  @@map("finance_period_events")
}

/// A double-entry journal entry. Draft -> Pending approval -> Posted. A posted entry can never be edited or deleted
/// (database trigger); a mistake is fixed by a reversing entry (reversal_of_id).
model JournalEntry {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// JE-2026-0001, from a database sequence.
  number         String             @unique @default(dbgenerated("((('JE-'::text || to_char(now(), 'YYYY'::text)) || '-'::text) || lpad((nextval('journal_entry_seq'::regclass))::text, 4, '0'::text))"))
  entryDate      DateTime           @map("entry_date") @db.Date
  description    String
  source         JournalSource      @default(manual)
  /// What created it (invoice id, payroll run id...). With source and purpose, unique: nothing is posted twice.
  sourceRef      String?            @map("source_ref")
  purpose        String?
  currency       Currency           @default(PKR)
  /// PKR per 1 unit of the entry currency (1 for PKR).
  exchangeRate   Decimal            @default(1) @map("exchange_rate") @db.Decimal(18, 6)
  /// Total of the debits in PKR (= total of the credits).
  totalBase      Decimal            @default(0) @map("total_base") @db.Decimal(14, 2)
  status         JournalEntryStatus @default(draft)
  projectId      String?            @map("project_id") @db.Uuid
  /// At most one reversal that is not rejected per entry (partial unique index "journal_entries_one_live_reversal",
  /// migration 20261112230000): a rejected reversal draft does not block a new one.
  reversalOfId   String?            @map("reversal_of_id") @db.Uuid
  makerId        String             @map("maker_id") @db.Uuid
  submittedAt    DateTime?          @map("submitted_at") @db.Timestamptz(3)
  /// The approval tier the amount needed when it was submitted (a level number).
  requiredLevel  Int?               @map("required_level")
  approvedBy     String?            @map("approved_by") @db.Uuid
  postedAt       DateTime?          @map("posted_at") @db.Timestamptz(3)
  rejectedBy     String?            @map("rejected_by") @db.Uuid
  rejectedReason String?            @map("rejected_reason")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy      String?            @map("created_by") @db.Uuid
  updatedAt      DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy      String?            @map("updated_by") @db.Uuid

  project    FinanceProject?     @relation(fields: [projectId], references: [id])
  reversalOf JournalEntry?       @relation("Reversal", fields: [reversalOfId], references: [id])
  reversedBy JournalEntry[]      @relation("Reversal")
  lines      JournalLine[]
  events     JournalEntryEvent[]
  receipts   Receipt[]

  @@unique([source, sourceRef, purpose])
  @@index([entryDate])
  @@index([status])
  @@index([reversalOfId])
  @@map("journal_entries")
}

model JournalLine {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entryId     String   @map("entry_id") @db.Uuid
  lineNo      Int      @map("line_no")
  accountId   String   @map("account_id") @db.Uuid
  description String?
  /// In the entry currency.
  debit       Decimal  @default(0) @db.Decimal(14, 2)
  credit      Decimal  @default(0) @db.Decimal(14, 2)
  /// In PKR (amount x exchange rate, rounded to 2 decimals).
  baseDebit   Decimal  @default(0) @map("base_debit") @db.Decimal(14, 2)
  baseCredit  Decimal  @default(0) @map("base_credit") @db.Decimal(14, 2)
  partyId     String?  @map("party_id") @db.Uuid
  employeeId  String?  @map("employee_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  entry    JournalEntry        @relation(fields: [entryId], references: [id])
  account  LedgerAccount       @relation(fields: [accountId], references: [id])
  party    Party?              @relation(fields: [partyId], references: [id])
  employee Employee?           @relation(fields: [employeeId], references: [id])
  matches  BankStatementLine[]

  @@unique([entryId, lineNo])
  @@index([accountId])
  @@index([partyId])
  @@map("journal_lines")
}

/// Status history of an entry (created, submitted, approved, rejected, posted...). Insert-only.
model JournalEntryEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entryId   String   @map("entry_id") @db.Uuid
  action    String
  actorId   String?  @map("actor_id") @db.Uuid
  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  entry JournalEntry @relation(fields: [entryId], references: [id])

  @@index([entryId])
  @@map("journal_entry_events")
}

/// Client invoice. Paid / part paid / unpaid is calculated from posted payment allocations, never stored.
model Invoice {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// INV-2026-0001, from a database sequence.
  number         String    @unique @default(dbgenerated("((('INV-'::text || to_char(now(), 'YYYY'::text)) || '-'::text) || lpad((nextval('invoice_seq'::regclass))::text, 4, '0'::text))"))
  partyId        String    @map("party_id") @db.Uuid
  issueDate      DateTime  @map("issue_date") @db.Date
  dueDate        DateTime  @map("due_date") @db.Date
  currency       Currency  @default(PKR)
  exchangeRate   Decimal   @default(1) @map("exchange_rate") @db.Decimal(18, 6)
  total          Decimal   @db.Decimal(14, 2)
  projectId      String?   @map("project_id") @db.Uuid
  notes          String?
  journalEntryId String?   @unique @map("journal_entry_id") @db.Uuid
  cancelledAt    DateTime? @map("cancelled_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy      String?   @map("created_by") @db.Uuid
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy      String?   @map("updated_by") @db.Uuid

  // ---- Module 13 (customer billing) extends this table; Module 9 still writes every ledger entry. ----
  /// draft (no ledger entry, temporary DRAFT- number) -> issued (INV- number, entry submitted) -> cancelled.
  /// Paid / part paid / overdue are still calculated, never stored. Rows that existed before M13 are issued.
  status            InvoiceStatus @default(issued)
  kind              InvoiceKind   @default(one_time)
  termsDays         Int?          @map("terms_days")
  /// The billing period this invoice covers (recurring and rental invoices).
  periodStart       DateTime?     @map("period_start") @db.Date
  periodEnd         DateTime?     @map("period_end") @db.Date
  recurringRuleId   String?       @map("recurring_rule_id") @db.Uuid
  /// Reminder days relative to the due date (-3 = 3 days before).
  reminderOffsets   Int[]         @default([]) @map("reminder_offsets")
  /// The staff member reminded about this invoice.
  assignedToId      String?       @map("assigned_to_id") @db.Uuid
  /// M15 connection point: a confirmed Won deal creates exactly one draft (unique).
  sourceDealNumber  String?       @unique @map("source_deal_number")
  sourceDealOwnerId String?       @map("source_deal_owner_id") @db.Uuid
  /// The client's retry key: the same create request never makes a second invoice.
  requestKey        String?       @unique @map("request_key")
  issuedAt          DateTime?     @map("issued_at") @db.Timestamptz(3)
  issuedBy          String?       @map("issued_by") @db.Uuid
  emailedAt         DateTime?     @map("emailed_at") @db.Timestamptz(3)
  cancelledBy       String?       @map("cancelled_by") @db.Uuid
  cancelReason      String?       @map("cancel_reason")
  /// The reversing entry made when an invoice whose entry was posted is cancelled.
  cancelEntryId     String?       @unique @map("cancel_entry_id") @db.Uuid
  /// When the "invoice paid" and "invoice overdue" events were sent (each once).
  paidEventAt       DateTime?     @map("paid_event_at") @db.Timestamptz(3)
  overdueEventAt    DateTime?     @map("overdue_event_at") @db.Timestamptz(3)

  party         Party                  @relation(fields: [partyId], references: [id])
  lines         InvoiceLine[]
  allocations   PaymentAllocation[]
  recurringRule RecurringBillingRule?  @relation(fields: [recurringRuleId], references: [id])
  /// Module 15.7: the commission line of a deal's own invoice (a relation only; no column on invoices).
  salesCommissionLine SalesCommissionLine?
  assignedTo    Employee?              @relation("InvoiceAssignee", fields: [assignedToId], references: [id])
  reminders     InvoiceReminder[]
  emails        BillingCustomerEmail[]

  @@unique([recurringRuleId, periodStart])
  @@index([partyId])
  @@index([status, dueDate])
  @@map("invoices")
}

model InvoiceLine {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId   String  @map("invoice_id") @db.Uuid
  lineNo      Int     @map("line_no")
  description String
  quantity    Decimal @db.Decimal(12, 2)
  unitPrice   Decimal @map("unit_price") @db.Decimal(14, 2)
  amount      Decimal @db.Decimal(14, 2)
  /// Income account credited.
  accountId   String  @map("account_id") @db.Uuid

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@unique([invoiceId, lineNo])
  @@map("invoice_lines")
}

/// Vendor bill or expense, with the receipt uploaded.
model Bill {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  number         String    @unique @default(dbgenerated("((('BILL-'::text || to_char(now(), 'YYYY'::text)) || '-'::text) || lpad((nextval('bill_seq'::regclass))::text, 4, '0'::text))"))
  partyId        String    @map("party_id") @db.Uuid
  vendorRef      String?   @map("vendor_ref")
  billDate       DateTime  @map("bill_date") @db.Date
  dueDate        DateTime  @map("due_date") @db.Date
  currency       Currency  @default(PKR)
  exchangeRate   Decimal   @default(1) @map("exchange_rate") @db.Decimal(18, 6)
  total          Decimal   @db.Decimal(14, 2)
  /// Expense (or asset) account debited.
  accountId      String    @map("account_id") @db.Uuid
  projectId      String?   @map("project_id") @db.Uuid
  description    String
  journalEntryId String?   @unique @map("journal_entry_id") @db.Uuid
  cancelledAt    DateTime? @map("cancelled_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy      String?   @map("created_by") @db.Uuid
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy      String?   @map("updated_by") @db.Uuid

  party       Party               @relation(fields: [partyId], references: [id])
  allocations PaymentAllocation[]
  receipts    Receipt[]

  @@index([partyId])
  @@map("bills")
}

/// Money received from a client or paid to a vendor through a bank account.
model Payment {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  direction      PaymentDirection
  partyId        String           @map("party_id") @db.Uuid
  bankAccountId  String           @map("bank_account_id") @db.Uuid
  paymentDate    DateTime         @map("payment_date") @db.Date
  currency       Currency         @default(PKR)
  exchangeRate   Decimal          @default(1) @map("exchange_rate") @db.Decimal(18, 6)
  amount         Decimal          @db.Decimal(14, 2)
  method         String?
  reference      String?
  journalEntryId String?          @unique @map("journal_entry_id") @db.Uuid
  /// M13: the client's retry key, so recording the same payment twice never makes a second one.
  requestKey     String?          @unique @map("request_key")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy      String?          @map("created_by") @db.Uuid

  party       Party               @relation(fields: [partyId], references: [id])
  allocations PaymentAllocation[]

  @@index([partyId])
  @@map("payments")
}

model PaymentAllocation {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId String   @map("payment_id") @db.Uuid
  invoiceId String?  @map("invoice_id") @db.Uuid
  billId    String?  @map("bill_id") @db.Uuid
  amount    Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  payment Payment  @relation(fields: [paymentId], references: [id])
  invoice Invoice? @relation(fields: [invoiceId], references: [id])
  bill    Bill?    @relation(fields: [billId], references: [id])

  @@index([invoiceId])
  @@index([billId])
  @@map("payment_allocations")
}

/// Receipt file metadata (the file lives in private storage).
model Receipt {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  billId           String?   @map("bill_id") @db.Uuid
  entryId          String?   @map("entry_id") @db.Uuid
  storageKey       String    @unique @map("storage_key")
  originalFilename String    @map("original_filename")
  mimeType         String    @map("mime_type")
  sizeBytes        Int       @map("size_bytes")
  sha256           String
  archivedAt       DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy        String?   @map("created_by") @db.Uuid

  bill  Bill?         @relation(fields: [billId], references: [id])
  entry JournalEntry? @relation(fields: [entryId], references: [id])

  @@index([billId])
  @@index([entryId])
  @@map("receipts")
}

model BankStatementImport {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bankAccountId String   @map("bank_account_id") @db.Uuid
  filename      String
  sha256        String
  lineCount     Int      @map("line_count")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy     String?  @map("created_by") @db.Uuid

  lines BankStatementLine[]

  @@unique([bankAccountId, sha256])
  @@map("bank_statement_imports")
}

model BankStatementLine {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  importId      String    @map("import_id") @db.Uuid
  lineNo        Int       @map("line_no")
  valueDate     DateTime  @map("value_date") @db.Date
  description   String
  /// Positive = money in, negative = money out, in the bank account's currency.
  amount        Decimal   @db.Decimal(14, 2)
  reference     String?
  matchedLineId String?   @unique @map("matched_line_id") @db.Uuid
  matchedBy     String?   @map("matched_by") @db.Uuid
  matchedAt     DateTime? @map("matched_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  statement   BankStatementImport @relation(fields: [importId], references: [id])
  matchedLine JournalLine?        @relation(fields: [matchedLineId], references: [id])

  @@unique([importId, lineNo])
  @@map("bank_statement_lines")
}

/// Small finance settings until Module 12 (one row, id = 1). Development defaults; management sets real values.
model FinanceSetting {
  id                    Int      @id @default(1)
  /// Approving an entry whose PKR total is above this asks for the password and code again ("large entries", plan section 16).
  stepUpAbove           Decimal  @map("step_up_above") @db.Decimal(14, 2)
  /// Entries above this PKR total (and every capital or loan entry) are reported to the Owner, who only views (decision D26).
  ownerNotifyAbove      Decimal  @default(500000) @map("owner_notify_above") @db.Decimal(14, 2)
  /// First month of the finance year (7 = July, Pakistan's normal tax year).
  financeYearStartMonth Int      @map("finance_year_start_month")
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy             String?  @map("updated_by") @db.Uuid

  @@map("finance_settings")
}

// ============================================================================================================
// Cycle 3 shared foundation: outbox readers, notifications (minimal Module 12 core), module-owned settings.
// ============================================================================================================

/// A module that reads outbox events. It sees only events written after it was first registered (started_at),
/// so switching a new reader on never replays the past.
model OutboxConsumer {
  name      String   @id
  startedAt DateTime @default(now()) @map("started_at") @db.Timestamptz(3)

  consumptions OutboxConsumption[]

  @@map("outbox_consumers")
}

enum OutboxConsumptionStatus {
  done
  failed
  dead
  skipped

  @@map("outbox_consumption_status")
}

/// One row per reader and event: handled (done), to be tried again (failed), given up after the last attempt (dead) or
/// unreadable for this reader (skipped). Unique per reader and event, so each reader processes each event once.
model OutboxConsumption {
  id            String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  consumer      String
  eventId       String                  @map("event_id") @db.Uuid
  status        OutboxConsumptionStatus
  attempts      Int                     @default(0)
  /// Never message bodies or personal data: the error class and a short message only.
  lastError     String?                 @map("last_error")
  nextAttemptAt DateTime?               @map("next_attempt_at") @db.Timestamptz(3)
  processedAt   DateTime?               @map("processed_at") @db.Timestamptz(3)
  createdAt     DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  reader OutboxConsumer @relation(fields: [consumer], references: [name])
  event  OutboxEvent    @relation(fields: [eventId], references: [id])

  @@unique([consumer, eventId])
  @@index([consumer, status, nextAttemptAt])
  @@map("outbox_consumptions")
}

/// An in-app notification (the bell). One per recipient and dedupe key, so a retried event never creates a second one.
model Notification {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientId   String    @map("recipient_id") @db.Uuid
  /// One of notificationTypeSchema (packages/contracts/src/notifications.ts).
  type          String
  title         String
  body          String?
  /// An app path such as /approvals (never an external URL).
  link          String?
  /// Approvals and security alerts: always shown and always emailed (plan section 17).
  essential     Boolean
  dedupeKey     String    @map("dedupe_key")
  sourceEventId String?   @map("source_event_id") @db.Uuid
  readAt        DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  recipient  Employee               @relation(fields: [recipientId], references: [id])
  deliveries NotificationDelivery[]

  @@unique([recipientId, dedupeKey])
  @@index([recipientId, createdAt])
  @@map("notifications")
}

/// A person's choices. Only emails can be turned off, and never for the essential types (database rule too).
model NotificationPreference {
  employeeId   String   @id @map("employee_id") @db.Uuid
  /// Notification types whose email this person turned off.
  emailOff     String[] @default([]) @map("email_off")
  /// Stored for the daily summary email (Module 12); the summary itself is not sent yet.
  dailySummary Boolean  @default(true) @map("daily_summary")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("notification_preferences")
}

enum NotificationDeliveryStatus {
  pending
  sending
  sent
  failed
  skipped
  /// The server stopped while sending: the outcome is unknown, so it is never sent again automatically.
  unknown

  @@map("notification_delivery_status")
}

/// One email per notification at most (unique), sent by the delivery worker with retries.
model NotificationDelivery {
  id             String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notificationId String                     @map("notification_id") @db.Uuid
  channel        String                     @default("email")
  status         NotificationDeliveryStatus @default(pending)
  /// Why it was skipped (turned_off, no_email, recipient_left), or the last error class.
  note           String?
  toAddress      String?                    @map("to_address")
  attempts       Int                        @default(0)
  nextAttemptAt  DateTime                   @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  claimedAt      DateTime?                  @map("claimed_at") @db.Timestamptz(3)
  sentAt         DateTime?                  @map("sent_at") @db.Timestamptz(3)
  createdAt      DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  notification Notification @relation(fields: [notificationId], references: [id])

  @@unique([notificationId, channel])
  @@index([status, nextAttemptAt])
  @@map("notification_deliveries")
}

/// Settings owned by one module (the pattern until Module 12's settings screen exists). The value is validated by the
/// module's own schema; version gives optimistic locking; every change is audited.
model ModuleSetting {
  module    String   @id
  value     Json
  version   Int      @default(1)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy String?  @map("updated_by") @db.Uuid

  @@map("module_settings")
}

// ============================================================================================================
// Module 13: customer billing, subscriptions and renewal management (plan section 18).
// Invoices, invoice lines, payments and the ledger stay in Module 9 (the tables above); these tables add the
// billing life cycle around them. Only Module 9 writes money.
// ============================================================================================================

enum InvoiceStatus {
  draft
  issued
  cancelled

  @@map("invoice_status")
}

enum InvoiceKind {
  one_time
  recurring
  rental

  @@map("invoice_kind")
}

enum BillingPeriod {
  monthly
  quarterly
  yearly

  @@map("billing_period")
}

enum RecurringRuleStatus {
  active
  ended

  @@map("recurring_rule_status")
}

enum ReminderAudience {
  customer
  staff

  @@map("reminder_audience")
}

enum ReminderStatus {
  scheduled
  sent
  skipped

  @@map("reminder_status")
}

enum CustomerEmailStatus {
  pending
  sending
  sent
  failed
  skipped
  unknown

  @@map("customer_email_status")
}

enum SubscriptionStatus {
  active
  cancelled

  @@map("subscription_status")
}

enum DealHandoverStatus {
  drafted
  needs_client

  @@map("deal_handover_status")
}

/// A confirmed Won deal received from Module 15 (one row per deal number). drafted = its draft invoice exists;
/// needs_client = several clients have exactly its client name, and Finance chooses the right one (never chosen silently).
model DealHandover {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dealNumber        String             @unique @map("deal_number")
  /// The event payload (client, service, value, currency, owner).
  payload           Json
  status            DealHandoverStatus
  candidatePartyIds String[]           @map("candidate_party_ids") @db.Uuid
  invoiceId         String?            @unique @map("invoice_id") @db.Uuid
  sourceEventId     String?            @map("source_event_id") @db.Uuid
  resolvedBy        String?            @map("resolved_by") @db.Uuid
  resolvedAt        DateTime?          @map("resolved_at") @db.Timestamptz(3)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status])
  @@map("deal_handovers")
}

enum SubscriptionPeriod {
  monthly
  quarterly
  yearly
  usage

  @@map("subscription_period")
}

enum RenewalEventKind {
  alert
  renewed
  changed
  cancelled

  @@map("renewal_event_kind")
}

/// A client's billing details (the client itself is the Module 9 party).
model BillingProfile {
  partyId         String   @id @map("party_id") @db.Uuid
  contactName     String?  @map("contact_name")
  termsDays       Int      @map("terms_days")
  taxId           String?  @map("tax_id")
  notes           String?
  /// A client created automatically from a Won deal: Finance reviews it before its invoice can be issued.
  needsReview     Boolean  @default(false) @map("needs_review")
  createdFromDeal String?  @map("created_from_deal")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy       String?  @map("created_by") @db.Uuid
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy       String?  @map("updated_by") @db.Uuid

  party Party @relation(fields: [partyId], references: [id])

  @@map("billing_profiles")
}

/// A recurring or rental billing rule. Each period it creates one draft invoice (unique per rule and period start)
/// for the finance duty person to check and issue.
model RecurringBillingRule {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partyId         String              @map("party_id") @db.Uuid
  kind            InvoiceKind
  period          BillingPeriod
  currency        Currency
  /// [{ description, quantity, unitPrice, accountId }]
  lines           Json
  termsDays       Int                 @map("terms_days")
  reminderOffsets Int[]               @map("reminder_offsets")
  assignedToId    String?             @map("assigned_to_id") @db.Uuid
  notes           String?
  startDate       DateTime            @map("start_date") @db.Date
  /// The last day billed; null = until stopped.
  endDate         DateTime?           @map("end_date") @db.Date
  /// The start of the next period to bill.
  nextPeriodStart DateTime            @map("next_period_start") @db.Date
  status          RecurringRuleStatus @default(active)
  endedAt         DateTime?           @map("ended_at") @db.Timestamptz(3)
  endedBy         String?             @map("ended_by") @db.Uuid
  endReason       String?             @map("end_reason")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy       String?             @map("created_by") @db.Uuid
  updatedAt       DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy       String?             @map("updated_by") @db.Uuid

  party      Party     @relation(fields: [partyId], references: [id])
  assignedTo Employee? @relation("RecurringRuleAssignee", fields: [assignedToId], references: [id])
  invoices   Invoice[]

  @@index([status, nextPeriodStart])
  @@map("recurring_billing_rules")
}

/// Reminder history: one row per invoice, reminder day and audience (unique), so a reminder is never sent twice.
model InvoiceReminder {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId       String           @map("invoice_id") @db.Uuid
  offsetDays      Int              @map("offset_days")
  audience        ReminderAudience
  scheduledFor    DateTime         @map("scheduled_for") @db.Date
  status          ReminderStatus   @default(scheduled)
  /// Why it was skipped (paid, cancelled, customer emails off...).
  reason          String?
  sentAt          DateTime?        @map("sent_at") @db.Timestamptz(3)
  notificationId  String?          @map("notification_id") @db.Uuid
  customerEmailId String?          @map("customer_email_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@unique([invoiceId, offsetDays, audience])
  @@index([status, scheduledFor])
  @@map("invoice_reminders")
}

/// Emails to customers (the invoice itself and reminders), sent by a worker with retries. Unique per dedupe key.
model BillingCustomerEmail {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId      String              @map("invoice_id") @db.Uuid
  /// invoice or reminder
  kind           String
  reminderOffset Int?                @map("reminder_offset")
  toAddress      String              @map("to_address")
  dedupeKey      String              @unique @map("dedupe_key")
  status         CustomerEmailStatus @default(pending)
  attempts       Int                 @default(0)
  nextAttemptAt  DateTime            @map("next_attempt_at") @db.Timestamptz(3)
  sentAt         DateTime?           @map("sent_at") @db.Timestamptz(3)
  lastError      String?             @map("last_error")
  note           String?
  createdBy      String?             @map("created_by") @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([status, nextAttemptAt])
  @@index([invoiceId])
  @@map("billing_customer_emails")
}

/// Aceva's own tools and services (Apollo, domains, mailboxes, AI tools, hosting, APIs...).
model Subscription {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// SUB-2026-0001, from a database sequence.
  number          String             @unique @default(dbgenerated("((('SUB-'::text || to_char(now(), 'YYYY'::text)) || '-'::text) || lpad((nextval('subscription_seq'::regclass))::text, 4, '0'::text))"))
  vendor          String
  product         String
  category        String
  /// The person responsible: renewal alerts go to them.
  ownerId         String             @map("owner_id") @db.Uuid
  plan            String
  cost            Decimal            @db.Decimal(14, 2)
  currency        Currency
  period          SubscriptionPeriod
  renewalDate     DateTime           @map("renewal_date") @db.Date
  alertDaysBefore Int                @map("alert_days_before")
  seats           Int?
  usageMetric     String?            @map("usage_metric")
  usageUnit       String?            @map("usage_unit")
  usageLimit      Decimal?           @map("usage_limit") @db.Decimal(18, 4)
  notes           String?
  status          SubscriptionStatus @default(active)
  cancelledAt     DateTime?          @map("cancelled_at") @db.Timestamptz(3)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy       String?            @map("created_by") @db.Uuid
  updatedAt       DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy       String?            @map("updated_by") @db.Uuid

  owner         Employee                   @relation("SubscriptionOwner", fields: [ownerId], references: [id])
  renewalEvents SubscriptionRenewalEvent[]
  usage         UsageSnapshot[]
  costs         SubscriptionCost[]

  @@index([status, renewalDate])
  @@map("subscriptions")
}

/// Renewal alerts and decisions (renewed, changed, cancelled). Insert-only. One alert per subscription and renewal date.
model SubscriptionRenewalEvent {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscriptionId String           @map("subscription_id") @db.Uuid
  kind           RenewalEventKind
  /// The renewal date this alert or decision is about.
  renewalDate    DateTime         @map("renewal_date") @db.Date
  newRenewalDate DateTime?        @map("new_renewal_date") @db.Date
  oldCost        Decimal?         @map("old_cost") @db.Decimal(14, 2)
  newCost        Decimal?         @map("new_cost") @db.Decimal(14, 2)
  oldPlan        String?          @map("old_plan")
  newPlan        String?          @map("new_plan")
  note           String?
  actorId        String?          @map("actor_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([subscriptionId])
  @@map("subscription_renewal_events")
}

/// A usage reading. Entered by hand (no provider API is connected yet); a cost on it is always an estimate. Insert-only.
model UsageSnapshot {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscriptionId String   @map("subscription_id") @db.Uuid
  readingDate    DateTime @map("reading_date") @db.Date
  used           Decimal  @db.Decimal(18, 4)
  /// The limit at the time of the reading (defaults to the subscription's limit).
  limit          Decimal? @db.Decimal(18, 4)
  estimatedCost  Decimal? @map("estimated_cost") @db.Decimal(14, 2)
  /// manual only for now; api is reserved for a provider connection.
  source         String   @default("manual")
  note           String?
  enteredBy      String?  @map("entered_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([subscriptionId, readingDate])
  @@map("usage_snapshots")
}

/// What a subscription cost in a month. Estimated unless it is backed by a Module 9 bill or the provider's invoice reference.
model SubscriptionCost {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscriptionId String   @map("subscription_id") @db.Uuid
  /// YYYY-MM
  month          String
  amount         Decimal  @db.Decimal(14, 2)
  currency       Currency
  estimated      Boolean
  billId         String?  @map("bill_id") @db.Uuid
  reference      String?
  note           String?
  enteredBy      String?  @map("entered_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy      String?  @map("updated_by") @db.Uuid

  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@unique([subscriptionId, month])
  @@map("subscription_costs")
}

// ============================================================================================================
// Module 14, part 1 (M14.1): conversations and messages (plan section 19).
// Message text lives only in messages.body and message_revisions.body. It is never copied into the audit log, the
// outbox or the application logs. Nothing here is hard-deleted (database triggers); retention periods are not decided
// yet, so nothing is deleted automatically.
// ============================================================================================================

enum ConversationKind {
  dm
  group
  channel

  @@map("conversation_kind")
}

/// What a channel is for: a department (members follow the employee records) or a project (members managed by hand).
enum ChannelScope {
  department
  project

  @@map("channel_scope")
}

enum ConversationRole {
  member
  moderator

  @@map("conversation_role")
}

/// Why an older version of a message was kept: the author edited it, the author deleted it, or a moderator removed it.
enum MessageRevisionKind {
  edited
  deleted
  removed

  @@map("message_revision_kind")
}

/// A direct message (two people), a group, or a department or project channel.
model Conversation {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind          ConversationKind
  channelScope  ChannelScope?    @map("channel_scope")
  name          String?
  topic         String?
  /// Department channels: the department whose current employees (and head) are members.
  departmentId  String?          @map("department_id") @db.Uuid
  /// Project channels: the project's name and code (copied from the Module 5 project when one is chosen).
  projectName   String?          @map("project_name")
  projectCode   String?          @map("project_code")
  /// Project channels: the Module 5 project it belongs to (null for channels made before projects could be chosen).
  projectId     String?          @map("project_id") @db.Uuid
  /// DMs only: the two people's ids in sorted order, so the same pair can never get a second DM (unique).
  dmKey         String?          @unique @map("dm_key")
  /// The last sequence number given to a message here. Raised in the same transaction as the message insert, under
  /// this row's lock, so concurrent sends are numbered one after another and a rolled-back send leaves no gap.
  lastSeq       Int              @default(0) @map("last_seq")
  lastMessageAt DateTime?        @map("last_message_at") @db.Timestamptz(3)
  createdById   String           @map("created_by_id") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @default(now()) @map("updated_at") @db.Timestamptz(3)
  archivedAt    DateTime?        @map("archived_at") @db.Timestamptz(3)
  archivedById  String?          @map("archived_by_id") @db.Uuid

  department       Department?               @relation(fields: [departmentId], references: [id])
  project          Project?                  @relation(fields: [projectId], references: [id])
  members          ConversationMember[]
  reads            ConversationRead[]
  messages         Message[]
  pins             PinnedMessage[]
  departmentAccess DepartmentChannelAccess[]

  files          CommsFile[]

  @@index([departmentId])
  @@index([projectId])
  @@index([kind])
  @@map("conversations")
}

/// People added to a conversation by hand (DM and group members, project channel members, moderators, and anyone added
/// to a department channel beyond its department). One row per person and conversation; leaving sets left_at.
model ConversationMember {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String           @map("conversation_id") @db.Uuid
  employeeId     String           @map("employee_id") @db.Uuid
  role           ConversationRole @default(member)
  addedById      String?          @map("added_by_id") @db.Uuid
  /// The conversation's last message number when this person was added (or added again): they see only later messages.
  joinedSeq      Int              @default(0) @map("joined_seq")
  joinedAt       DateTime         @default(now()) @map("joined_at") @db.Timestamptz(3)
  leftAt         DateTime?        @map("left_at") @db.Timestamptz(3)
  removedById    String?          @map("removed_by_id") @db.Uuid
  updatedAt      DateTime         @default(now()) @map("updated_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id])
  employee     Employee     @relation(fields: [employeeId], references: [id])

  @@unique([conversationId, employeeId])
  @@index([employeeId])
  @@map("conversation_members")
}

/// How far each person has received and read a conversation (sequence numbers). Kept apart from the member rows because
/// department channel members are worked out from the employee records and have no member row.
model ConversationRead {
  conversationId   String   @map("conversation_id") @db.Uuid
  employeeId       String   @map("employee_id") @db.Uuid
  lastDeliveredSeq Int      @default(0) @map("last_delivered_seq")
  lastReadSeq      Int      @default(0) @map("last_read_seq")
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id])
  employee     Employee     @relation(fields: [employeeId], references: [id])

  @@id([conversationId, employeeId])
  @@index([employeeId])
  @@map("conversation_reads")
}

/// When someone became a member of a department channel through the employee records (hired into the department,
/// moved into it, or made its head): they see only messages after from_seq. Written by database triggers on employees
/// and departments, so every way of changing a department is covered. No row = a member since before the channel existed.
model DepartmentChannelAccess {
  conversationId String   @map("conversation_id") @db.Uuid
  employeeId     String   @map("employee_id") @db.Uuid
  fromSeq        Int      @map("from_seq")
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id])
  employee     Employee     @relation(fields: [employeeId], references: [id])

  @@id([conversationId, employeeId])
  @@index([employeeId])
  @@map("department_channel_access")
}

/// One message. seq is unique per conversation and has no gaps; client_key is the sender's retry key (unique per author).
/// A deleted or removed message keeps its row as a placeholder with an empty body; the text is kept in message_revisions.
model Message {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String               @map("conversation_id") @db.Uuid
  seq            Int
  authorId       String               @map("author_id") @db.Uuid
  /// A reply: the top-level message of the same conversation it answers.
  parentId       String?              @map("parent_id") @db.Uuid
  /// Plain text, at most 4,000 characters. Empty only once deleted.
  body           String
  clientKey      String               @map("client_key") @db.Uuid
  /// SHA-256 of what was first sent with this retry key, so a retry with different content is refused.
  requestHash    String               @map("request_hash")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  editedAt       DateTime?            @map("edited_at") @db.Timestamptz(3)
  /// How many older versions are kept in message_revisions.
  revision       Int                  @default(0)
  deletedAt      DateTime?            @map("deleted_at") @db.Timestamptz(3)
  deletedById    String?              @map("deleted_by_id") @db.Uuid
  deletedAs      MessageRevisionKind? @map("deleted_as")

  conversation Conversation      @relation(fields: [conversationId], references: [id])
  author       Employee          @relation("MessageAuthor", fields: [authorId], references: [id])
  parent       Message?          @relation("MessageReplies", fields: [parentId], references: [id])
  replies      Message[]         @relation("MessageReplies")
  revisions    MessageRevision[]
  reactions    MessageReaction[]
  mentions     MessageMention[]
  saves        SavedMessage[]
  pin          PinnedMessage?

  files        CommsFile[]
  taskLink     MessageTaskLink?

  @@unique([conversationId, seq])
  @@unique([authorId, clientKey])
  @@index([conversationId, parentId, seq])
  @@index([authorId, createdAt])
  @@map("messages")
}

/// Older versions of a message (insert-only). Kept in the database for the retention period, never shown in the app.
model MessageRevision {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId   String              @map("message_id") @db.Uuid
  revision    Int
  kind        MessageRevisionKind
  /// The text as it was before this change.
  body        String
  changedById String              @map("changed_by_id") @db.Uuid
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  message Message @relation(fields: [messageId], references: [id])

  @@unique([messageId, revision])
  @@map("message_revisions")
}

/// Someone mentioned in a message (by Emp-ID; always a member of the conversation).
model MessageMention {
  messageId  String   @map("message_id") @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  message  Message  @relation(fields: [messageId], references: [id])
  employee Employee @relation("MessageMentioned", fields: [employeeId], references: [id])

  @@id([messageId, employeeId])
  @@index([employeeId])
  @@map("message_mentions")
}

model MessageReaction {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId  String   @map("message_id") @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  emoji      String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  message  Message  @relation(fields: [messageId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([messageId, employeeId, emoji])
  @@map("message_reactions")
}

/// A person's own saved messages (private to them).
model SavedMessage {
  employeeId String   @map("employee_id") @db.Uuid
  messageId  String   @map("message_id") @db.Uuid
  savedAt    DateTime @default(now()) @map("saved_at") @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id])
  message  Message  @relation(fields: [messageId], references: [id])

  @@id([employeeId, messageId])
  @@index([employeeId, savedAt])
  @@map("saved_messages")
}

/// A message pinned in its conversation (once).
model PinnedMessage {
  messageId      String   @id @map("message_id") @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  pinnedById     String   @map("pinned_by_id") @db.Uuid
  pinnedAt       DateTime @default(now()) @map("pinned_at") @db.Timestamptz(3)

  message      Message      @relation(fields: [messageId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
  @@map("pinned_messages")
}

/// Module 14: an announcement to the whole company or to chosen departments (plan section 19). Who it reaches follows the
/// CURRENT employee records (like department channels): someone who joins a department later sees its announcements.
/// Never deleted; only the pin can change (database triggers).
model Announcement {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  body        String
  authorId    String    @map("author_id") @db.Uuid
  /// Everyone in the company (otherwise: the departments in announcement_departments).
  audienceAll Boolean   @map("audience_all")
  requiresAck Boolean   @map("requires_ack")
  pinned      Boolean   @default(false)
  pinnedAt    DateTime? @map("pinned_at") @db.Timestamptz(3)
  pinnedById  String?   @map("pinned_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  author      Employee                 @relation("AnnouncementAuthor", fields: [authorId], references: [id])
  pinnedBy    Employee?                @relation("AnnouncementPinnedBy", fields: [pinnedById], references: [id])
  departments AnnouncementDepartment[]
  acks        AnnouncementAck[]

  @@index([createdAt])
  @@map("announcements")
}

/// The departments an announcement is for (none when it is for everyone).
model AnnouncementDepartment {
  announcementId String @map("announcement_id") @db.Uuid
  departmentId   String @map("department_id") @db.Uuid

  announcement Announcement @relation(fields: [announcementId], references: [id])
  department   Department   @relation(fields: [departmentId], references: [id])

  @@id([announcementId, departmentId])
  @@index([departmentId])
  @@map("announcement_departments")
}

/// "I've read this": one row per person, insert-only (the record of who acknowledged and when).
model AnnouncementAck {
  announcementId String   @map("announcement_id") @db.Uuid
  employeeId     String   @map("employee_id") @db.Uuid
  ackedAt        DateTime @default(now()) @map("acked_at") @db.Timestamptz(3)

  announcement Announcement @relation(fields: [announcementId], references: [id])
  employee     Employee     @relation(fields: [employeeId], references: [id])

  @@id([announcementId, employeeId])
  @@index([employeeId])
  @@map("announcement_acks")
}

/// A meeting invitee's answer.
enum MeetingRsvp {
  pending
  yes
  no
  maybe

  @@map("meeting_rsvp")
}

/// Module 14: a meeting (plan section 19: "create a meeting, invite participants, set date/time, share an agenda and attach
/// notes or files"). Private to its organizer and the people invited. Never deleted: a cancelled meeting stays, read-only.
model Meeting {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title            String
  startsAt         DateTime  @map("starts_at") @db.Timestamptz(3)
  durationMin      Int       @map("duration_min")
  location         String
  agenda           String    @default("")
  /// Written by the organizer during or after the meeting; read by everyone invited.
  notes            String?
  notesUpdatedAt   DateTime? @map("notes_updated_at") @db.Timestamptz(3)
  notesUpdatedById String?   @map("notes_updated_by_id") @db.Uuid
  organizerId      String    @map("organizer_id") @db.Uuid
  cancelledAt      DateTime? @map("cancelled_at") @db.Timestamptz(3)
  cancelledById    String?   @map("cancelled_by_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  organizer      Employee             @relation("MeetingOrganizer", fields: [organizerId], references: [id])
  notesUpdatedBy Employee?            @relation("MeetingNotesEditor", fields: [notesUpdatedById], references: [id])
  cancelledBy    Employee?            @relation("MeetingCanceller", fields: [cancelledById], references: [id])
  participants   MeetingParticipant[]
  files          CommsFile[]
  taskLinks      MeetingTaskLink[]

  @@index([organizerId, startsAt])
  @@index([startsAt])
  @@map("meetings")
}

/// Someone invited to a meeting, with their answer. Invitations are never withdrawn (the meeting is cancelled instead).
model MeetingParticipant {
  meetingId   String      @map("meeting_id") @db.Uuid
  employeeId  String      @map("employee_id") @db.Uuid
  rsvp        MeetingRsvp @default(pending)
  respondedAt DateTime?   @map("responded_at") @db.Timestamptz(3)
  invitedAt   DateTime    @default(now()) @map("invited_at") @db.Timestamptz(3)
  invitedById String      @map("invited_by_id") @db.Uuid

  meeting   Meeting  @relation(fields: [meetingId], references: [id])
  employee  Employee @relation("MeetingParticipant", fields: [employeeId], references: [id])
  invitedBy Employee @relation("MeetingInviter", fields: [invitedById], references: [id])

  @@id([meetingId, employeeId])
  @@index([employeeId])
  @@map("meeting_participants")
}

/// Where a shared file is in its malware check: files are opened only once "clean".
enum CommsFileScan {
  scanning
  clean
  blocked

  @@map("comms_file_scan")
}

/// Module 14: a file shared in a conversation (attached to a message) or added to a meeting (plan section 19: "File
/// sharing with file-type and size limits, malware scanning, private storage and permission-checked download links").
/// The bytes are in private storage (never a public folder); a download goes through the API, which checks access every
/// time. A blocked file's bytes are removed; the record stays. Never deleted.
model CommsFile {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// A conversation file (then attached to one message when it is sent), or a meeting file.
  conversationId String?       @map("conversation_id") @db.Uuid
  messageId      String?       @map("message_id") @db.Uuid
  meetingId      String?       @map("meeting_id") @db.Uuid
  uploaderId     String        @map("uploader_id") @db.Uuid
  fileName       String        @map("file_name")
  mimeType       String        @map("mime_type")
  sizeBytes      Int           @map("size_bytes")
  sha256         String
  storageKey     String        @unique @map("storage_key")
  scanStatus     CommsFileScan @default(scanning) @map("scan_status")
  /// What ClamAV found in a blocked file (a signature name, never file content).
  scanSignature  String?       @map("scan_signature")
  scannedAt      DateTime?     @map("scanned_at") @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  /// A conversation file uploaded but never sent: its bytes were removed after the grace period (the record stays).
  discardedAt    DateTime?     @map("discarded_at") @db.Timestamptz(3)

  conversation Conversation? @relation(fields: [conversationId], references: [id])
  message      Message?      @relation(fields: [messageId], references: [id])
  meeting      Meeting?      @relation(fields: [meetingId], references: [id])
  uploader     Employee      @relation(fields: [uploaderId], references: [id])

  @@index([messageId])
  @@index([meetingId])
  @@index([conversationId])
  @@index([scanStatus])
  @@index([uploaderId, createdAt])
  @@map("comms_files")
}

/// Module 14: a message linked to the Module 5 task it is about (one task per message). Only someone who may see the task
/// links it; people who may not see it are told only that a task is linked, never which.
model MessageTaskLink {
  messageId  String   @id @map("message_id") @db.Uuid
  taskId     String   @map("task_id") @db.Uuid
  linkedById String   @map("linked_by_id") @db.Uuid
  linkedAt   DateTime @default(now()) @map("linked_at") @db.Timestamptz(3)

  message  Message  @relation(fields: [messageId], references: [id])
  task     Task     @relation(fields: [taskId], references: [id])
  linkedBy Employee @relation(fields: [linkedById], references: [id])

  @@index([taskId])
  @@map("message_task_links")
}

/// Module 14: Module 5 tasks a meeting is about (linked by its organizer).
model MeetingTaskLink {
  meetingId  String   @map("meeting_id") @db.Uuid
  taskId     String   @map("task_id") @db.Uuid
  linkedById String   @map("linked_by_id") @db.Uuid
  linkedAt   DateTime @default(now()) @map("linked_at") @db.Timestamptz(3)

  meeting  Meeting  @relation(fields: [meetingId], references: [id])
  task     Task     @relation(fields: [taskId], references: [id])
  linkedBy Employee @relation(fields: [linkedById], references: [id])

  @@id([meetingId, taskId])
  @@index([taskId])
  @@map("meeting_task_links")
}

// ---------------------------------------------------------------------------
// Module 15: sales and CRM (plan section 20). M15.1: leads and companies.
// ---------------------------------------------------------------------------

/// Where a lead came from (plan section 20). Always recorded.
enum SalesLeadSource {
  apollo
  fiverr
  linkedin
  referral
  website
  field
  walk_in

  @@map("sales_lead_source")
}

/// The email check result. Module 16 (MillionVerifier) fills it in later; Module 15 only stores it ("unchecked").
enum SalesEmailCheck {
  unchecked
  valid
  invalid
  catch_all
  unknown

  @@map("sales_email_check")
}

/// One record per company (plan section 20). `domain` is the normalised website domain: at most one company that is not
/// archived per domain (partial unique index in the migration), so the same company is never entered twice.
model SalesCompany {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  website    String?
  /// The normalised website domain ("acme.com"): null when there is no website, or when the website's domain is a shared
  /// one (a marketplace or social profile) listed in the sales settings.
  domain     String?
  country    String?
  industry   String?
  /// The Module 9 client, once the company is one (Won deal handover, M15.2). Read-only for Module 15.
  partyId    String?   @map("party_id") @db.Uuid
  /// Optimistic locking: an edit names the version it read.
  version    Int       @default(1)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy  String?   @map("created_by") @db.Uuid
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy  String?   @map("updated_by") @db.Uuid

  party Party?      @relation(fields: [partyId], references: [id])
  leads SalesLead[]
  deals SalesDeal[]

  @@index([name])
  @@map("sales_companies")
}

/// One record per person (plan section 20). Each lead has exactly one owner (a salesperson's Emp-ID). `emailNormalized`
/// is unique among leads that are not archived (partial unique index in the migration): the database, not the screen,
/// is what makes a second copy impossible.
model SalesLead {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName        String          @map("full_name")
  jobTitle        String?         @map("job_title")
  companyId       String?         @map("company_id") @db.Uuid
  email           String?
  /// Lower-case, trimmed email used for the duplicate check. Null exactly when `email` is null (CHECK in the migration).
  emailNormalized String?         @map("email_normalized")
  phone           String?
  linkedinUrl     String?         @map("linkedin_url")
  country         String?
  industry        String?
  source          SalesLeadSource
  ownerId         String          @map("owner_id") @db.Uuid
  emailCheck      SalesEmailCheck @default(unchecked) @map("email_check")
  emailCheckedAt  DateTime?       @map("email_checked_at") @db.Timestamptz(3)
  notes           String?
  /// When the lead was added; logged contacts move it forward (M15.3). What counts as "activity" for the 12-month
  /// archive rule is still a management decision (D-10).
  lastActivityAt  DateTime        @default(now()) @map("last_activity_at") @db.Timestamptz(3)
  version         Int             @default(1)
  archivedAt      DateTime?       @map("archived_at") @db.Timestamptz(3)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy       String?         @map("created_by") @db.Uuid
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy       String?         @map("updated_by") @db.Uuid
  /// M15.4: when a do-not-contact request was saved on the lead. Once set it never changes (a trigger checks it).
  dncAt           DateTime?       @map("dnc_at") @db.Timestamptz(3)
  /// M15.4: the import that added the lead (who imported it and when is on the batch).
  importBatchId   String?         @map("import_batch_id") @db.Uuid

  company    SalesCompany?   @relation(fields: [companyId], references: [id])
  deals      SalesDeal[]
  activities SalesActivity[]
  owner   Employee      @relation("SalesLeadOwner", fields: [ownerId], references: [id])
  importBatch SalesImportBatch? @relation(fields: [importBatchId], references: [id])
  dncEntries  SalesDncEntry[]
  archives    SalesLeadArchive[]

  @@index([ownerId])
  @@index([companyId])
  @@index([lastActivityAt])
  @@map("sales_leads")
}

// ---------------------------------------------------------------------------
// Module 15.2: deals and the pipeline (plan section 20).
// ---------------------------------------------------------------------------

/// The eight pipeline stages of plan section 20, in order. Won and Lost are final.
enum SalesDealStage {
  new
  contacted
  replied
  meeting_booked
  proposal_sent
  negotiation
  won
  lost

  @@map("sales_deal_stage")
}

/// The services Aceva sells (plan section 20).
enum SalesDealService {
  website
  custom_software
  ai_automation
  mobile_app
  ecommerce

  @@map("sales_deal_service")
}

/// Won is marked by the salesperson (pending) and confirmed by the sales manager (confirmed). A request sent back is none again.
enum SalesWonStatus {
  none
  pending
  confirmed

  @@map("sales_won_status")
}

/// What a deal history row records.
enum SalesDealEvent {
  created
  stage_changed
  won_requested
  won_rejected
  won_confirmed
  owner_changed

  @@map("sales_deal_event")
}

/// One sales opportunity with a company (plan section 20). Its owner is the lead's owner. The number (DL-YYYY-NNNN) is
/// what people and Module 13 see. CHECKs in the migration: an open deal has a next step with a date; a Lost deal has a
/// reason and a re-contact date; a Won deal is confirmed; a pending Won request sits in an open stage.
model SalesDeal {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// DL-YYYY-NNNN from the sales_deal_seq sequence (default in the migration).
  number           String           @unique @default(dbgenerated("((('DL-'::text || to_char(now(), 'YYYY'::text)) || '-'::text) || lpad((nextval('sales_deal_seq'::regclass))::text, 4, '0'::text))"))
  leadId           String           @map("lead_id") @db.Uuid
  companyId        String           @map("company_id") @db.Uuid
  ownerId          String           @map("owner_id") @db.Uuid
  service          SalesDealService
  value            Decimal          @db.Decimal(12, 2)
  currency         Currency
  expectedClose    DateTime         @map("expected_close") @db.Date
  stage            SalesDealStage   @default(new)
  nextStep         String?          @map("next_step")
  nextStepDate     DateTime?        @map("next_step_date") @db.Date
  /// M15.3: the proposal's link (link only; files would need the Module 14 safety pipeline).
  proposalUrl      String?          @map("proposal_url")
  lostReason       String?          @map("lost_reason")
  lostNote         String?          @map("lost_note")
  recontactAfter   DateTime?        @map("recontact_after") @db.Date
  wonStatus        SalesWonStatus   @default(none) @map("won_status")
  wonRequestedAt   DateTime?        @map("won_requested_at") @db.Timestamptz(3)
  wonRequestedById String?          @map("won_requested_by_id") @db.Uuid
  wonConfirmedAt   DateTime?        @map("won_confirmed_at") @db.Timestamptz(3)
  wonConfirmedById String?          @map("won_confirmed_by_id") @db.Uuid
  /// When the deal became Won or Lost.
  closedAt         DateTime?        @map("closed_at") @db.Timestamptz(3)
  version          Int              @default(1)
  archivedAt       DateTime?        @map("archived_at") @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy        String?          @map("created_by") @db.Uuid
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy        String?          @map("updated_by") @db.Uuid

  lead           SalesLead          @relation(fields: [leadId], references: [id])
  company        SalesCompany       @relation(fields: [companyId], references: [id])
  owner          Employee           @relation("SalesDealOwner", fields: [ownerId], references: [id])
  wonRequestedBy Employee?          @relation("SalesDealWonRequester", fields: [wonRequestedById], references: [id])
  wonConfirmedBy Employee?          @relation("SalesDealWonConfirmer", fields: [wonConfirmedById], references: [id])
  history        SalesDealHistory[]
  activities     SalesActivity[]
  wonExceptions  SalesWonException[]
  commissionLine SalesCommissionLine?
  commissionEligibility SalesCommissionEligibility?

  @@index([ownerId, stage])
  @@index([leadId])
  @@index([companyId])
  @@index([stage])
  @@map("sales_deals")
}

/// Every stage change and Won decision of a deal, in order. Insert-only (a trigger refuses changes and removal).
model SalesDealHistory {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dealId    String          @map("deal_id") @db.Uuid
  event     SalesDealEvent
  fromStage SalesDealStage? @map("from_stage")
  toStage   SalesDealStage  @map("to_stage")
  /// Null for a change made by the system (for example a lead moved when its owner left, M15.5).
  actorId   String?         @map("actor_id") @db.Uuid
  reason    String?
  note      String?
  at        DateTime        @default(now()) @db.Timestamptz(3)

  deal  SalesDeal @relation(fields: [dealId], references: [id])
  actor Employee? @relation(fields: [actorId], references: [id])

  @@index([dealId, at])
  @@map("sales_deal_history")
}

// ---------------------------------------------------------------------------
// Module 15.3: activities and follow-ups (plan section 20).
// ---------------------------------------------------------------------------

/// What an activity on the timeline is. follow_up = a deal's next step was done (POST /sales/deals/:id/follow-up).
enum SalesActivityKind {
  call
  email_sent
  reply
  meeting
  linkedin
  whatsapp
  fiverr
  proposal
  note
  follow_up

  @@map("sales_activity_kind")
}

/// One contact on a lead's (and optionally a deal's) timeline. Insert-only: a mistake is corrected by a new entry.
/// source = manual for entries typed in by hand; Module 16 writes tool entries (apollo, millionverifier, mailbox) with
/// the tool's own id in externalId, unique per tool, so a sync never counts the same item twice.
model SalesActivity {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId      String            @map("lead_id") @db.Uuid
  /// The deal it is about, when there is one (always a deal of the same lead: a trigger checks it).
  dealId      String?           @map("deal_id") @db.Uuid
  /// Who did it (null only for a tool activity not linked to an employee, Module 16).
  actorId     String?           @map("actor_id") @db.Uuid
  kind        SalesActivityKind
  source      String            @default("manual")
  /// When it happened (it can be earlier than when it was typed in).
  occurredAt  DateTime          @map("occurred_at") @db.Timestamptz(3)
  summary     String
  meetingAt   DateTime?         @map("meeting_at") @db.Timestamptz(3)
  proposalUrl String?           @map("proposal_url")
  externalId  String?           @map("external_id")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  lead  SalesLead  @relation(fields: [leadId], references: [id])
  deal  SalesDeal? @relation(fields: [dealId], references: [id])
  actor Employee?  @relation(fields: [actorId], references: [id])

  @@index([leadId, occurredAt])
  @@index([dealId, occurredAt])
  @@index([actorId, occurredAt])
  @@map("sales_activities")
}

// ---------------------------------------------------------------------------
// Module 15.4: the do-not-contact list and the lead import (plan section 20).
// ---------------------------------------------------------------------------

/// The do-not-contact list. Insert-only (triggers): an entry is never changed or removed, also after its lead is archived.
/// It keeps a keyed hash (HMAC-SHA256, its own secret) of the normalised email and a masked form, never the email.
model SalesDncEntry {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// HMAC-SHA256 of the normalised email, hex (null for a lead marked while it had no email).
  emailHmac   String?  @map("email_hmac")
  /// Which key made the hash (SALES_DNC_HMAC_KEY_ID), so older entries still match after a key rotation.
  keyId       String?  @map("key_id")
  /// "a***@domain.com".
  maskedEmail String?  @map("masked_email")
  /// The lead it was marked on (null for an email added without a lead).
  leadId      String?  @map("lead_id") @db.Uuid
  reason      String
  /// manual (a person in Aceva); apollo and mailbox are for unsubscribes reported by Module 16.
  source      String   @default("manual")
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  lead    SalesLead? @relation(fields: [leadId], references: [id])
  creator Employee?  @relation(fields: [createdBy], references: [id])

  @@index([leadId])
  @@index([createdAt])
  @@map("sales_dnc_entries")
}

/// A lead import: the parsed rows wait here for 30 minutes between the preview and the commit (then they are cleared).
/// It records who imported for whom, the file's SHA-256, and the result.
model SalesImportBatch {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdBy   String          @map("created_by") @db.Uuid
  ownerId     String          @map("owner_id") @db.Uuid
  source      SalesLeadSource
  fileName    String          @map("file_name")
  fileSha256  String          @map("file_sha256")
  rowCount    Int             @map("row_count")
  /// The checked rows of the preview; emptied once the batch is committed or has expired.
  rows        Json            @default("[]")
  /// previewed, committed or expired.
  status      String          @default("previewed")
  expiresAt   DateTime        @map("expires_at") @db.Timestamptz(3)
  committedAt DateTime?       @map("committed_at") @db.Timestamptz(3)
  /// What the commit did: { created, skipped: [{line, status}] } (no personal data).
  result      Json?
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  creator Employee    @relation("SalesImportCreatedBy", fields: [createdBy], references: [id])
  owner   Employee    @relation("SalesImportOwner", fields: [ownerId], references: [id])
  leads   SalesLead[]

  @@index([createdBy, createdAt])
  @@map("sales_import_batches")
}

// ---------------------------------------------------------------------------
// Module 15.5: leads and deals when a salesperson leaves, and archiving inactive leads (plan section 20).
// ---------------------------------------------------------------------------

/// Why and when a lead was archived, and which contact details were removed. Insert-only (triggers).
model SalesLeadArchive {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId         String   @map("lead_id") @db.Uuid
  archivedAt     DateTime @map("archived_at") @db.Timestamptz(3)
  /// inactive: no activity for the set number of months.
  reason         String
  inactiveMonths Int      @map("inactive_months")
  lastActivityAt DateTime @map("last_activity_at") @db.Timestamptz(3)
  clearedFields  String[] @map("cleared_fields")
  /// Who archived it; null when the nightly job did (then `job` names the run).
  archivedBy     String?  @map("archived_by") @db.Uuid
  job            String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  lead     SalesLead @relation(fields: [leadId], references: [id])
  archiver Employee? @relation(fields: [archivedBy], references: [id])

  @@index([leadId, archivedAt])
  @@map("sales_lead_archives")
}

/// A leaver whose leads and deals could not be moved (no single sales manager, and their manager cannot receive them).
/// It waits for management; a later run that moves them (or finds nothing left) marks it resolved.
model SalesReassignmentIssue {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId   String    @map("employee_id") @db.Uuid
  /// The employee.offboarded event, when it came from one (null when the nightly check found it).
  eventId      String?   @map("event_id") @db.Uuid
  /// no_recipient
  reason       String
  details      Json
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt   DateTime? @map("resolved_at") @db.Timestamptz(3)
  resolvedToId String?   @map("resolved_to_id") @db.Uuid

  employee   Employee  @relation("SalesReassignLeaver", fields: [employeeId], references: [id])
  resolvedTo Employee? @relation("SalesReassignResolvedTo", fields: [resolvedToId], references: [id])

  @@index([employeeId])
  @@map("sales_reassignment_issues")
}

/// M15.5 follow-up: an exceptional Won decision (confirm or send back) on a request whose requester has left and that nobody
/// else could decide. Insert-only (triggers). It keeps the original request (who asked, when, who owned the deal then).
model SalesWonException {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dealId           String   @map("deal_id") @db.Uuid
  /// confirm or send_back
  decision         String
  reason           String
  /// requester_left_no_confirmer
  basis            String
  decidedById      String   @map("decided_by_id") @db.Uuid
  requesterId      String   @map("requester_id") @db.Uuid
  requestedAt      DateTime @map("requested_at") @db.Timestamptz(3)
  ownerAtRequestId String   @map("owner_at_request_id") @db.Uuid
  currentOwnerId   String   @map("current_owner_id") @db.Uuid
  /// What was checked: the moves after the request, and that no sales manager could decide.
  details          Json
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  deal           SalesDeal @relation(fields: [dealId], references: [id])
  decidedBy      Employee  @relation("SalesWonExceptionDecider", fields: [decidedById], references: [id])
  requester      Employee  @relation("SalesWonExceptionRequester", fields: [requesterId], references: [id])
  ownerAtRequest Employee  @relation("SalesWonExceptionOwnerAtRequest", fields: [ownerAtRequestId], references: [id])
  currentOwner   Employee  @relation("SalesWonExceptionCurrentOwner", fields: [currentOwnerId], references: [id])

  @@index([dealId, createdAt])
  @@map("sales_won_exceptions")
}

// ---------------------------------------------------------------------------
// Module 15.6: targets, the manual daily log, the nightly daily report (plan section 20).
// ---------------------------------------------------------------------------

/// A salesperson's daily targets from a day on (insert-only: a change is a new row; the latest row for the latest
/// effective day on or before a day is in force that day). Null = no target for that metric.
model SalesDailyTarget {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId    String   @map("employee_id") @db.Uuid
  effectiveFrom DateTime @map("effective_from") @db.Date
  leadsAdded    Int?     @map("leads_added")
  emailsChecked Int?     @map("emails_checked")
  emailsSent    Int?     @map("emails_sent")
  followUpsDone Int?     @map("follow_ups_done")
  setById       String   @map("set_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  employee Employee @relation("SalesDailyTargetFor", fields: [employeeId], references: [id])
  setBy    Employee @relation("SalesDailyTargetSetBy", fields: [setById], references: [id])

  @@index([employeeId, effectiveFrom, createdAt])
  @@map("sales_daily_targets")
}

/// A salesperson's targets for a month (insert-only; the latest row for the month is in force). The deals-won target has
/// an amount and a currency (both or neither); only deals in that currency count toward it.
model SalesMonthlyTarget {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId     String    @map("employee_id") @db.Uuid
  month          String
  meetingsBooked Int?      @map("meetings_booked")
  proposalsSent  Int?      @map("proposals_sent")
  wonAmount      Decimal?  @map("won_amount") @db.Decimal(14, 2)
  wonCurrency    Currency? @map("won_currency")
  setById        String    @map("set_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  employee Employee @relation("SalesMonthlyTargetFor", fields: [employeeId], references: [id])
  setBy    Employee @relation("SalesMonthlyTargetSetBy", fields: [setById], references: [id])

  @@index([employeeId, month, createdAt])
  @@map("sales_monthly_targets")
}

/// The manual daily log (self-reported counts). Insert-only: every save is a new version; the highest version is current.
model SalesDailyLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId  String   @map("employee_id") @db.Uuid
  day         DateTime @db.Date
  version     Int
  linkedin    Int
  whatsapp    Int
  fiverr      Int
  calls       Int
  fieldVisits Int      @map("field_visits")
  note        String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  employee Employee            @relation(fields: [employeeId], references: [id])
  reports  SalesDailyReport[]
  proofs   SalesProofRequest[]

  @@unique([employeeId, day, version])
  @@map("sales_daily_logs")
}

/// The nightly report of one person for one working day, exactly as built: the targets, the measures, the log version and
/// the result at that moment. Insert-only, one per person and day: never rebuilt or overwritten.
model SalesDailyReport {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId  String   @map("employee_id") @db.Uuid
  day         DateTime @db.Date
  generatedAt DateTime @map("generated_at") @db.Timestamptz(3)
  job         String
  /// The daily targets in force that day (null = none).
  targets     Json?
  /// { metric: { value, measured, target, met } }
  metrics     Json
  /// Every target set and measurable was met; null when none was set.
  met         Boolean?
  logId       String?  @map("log_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  employee Employee       @relation(fields: [employeeId], references: [id])
  log      SalesDailyLog? @relation(fields: [logId], references: [id])

  @@unique([employeeId, day])
  @@index([day])
  @@map("sales_daily_reports")
}

/// A sales manager's request for proof of a day's self-reported work: open, then answered by the salesperson, then
/// closed by the manager. Only its status, answer and closing change (a trigger keeps the rest); never deleted.
model SalesProofRequest {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId    String    @map("employee_id") @db.Uuid
  day           DateTime  @db.Date
  logId         String    @map("log_id") @db.Uuid
  status        String    @default("open")
  note          String
  requestedById String    @map("requested_by_id") @db.Uuid
  requestedAt   DateTime  @default(now()) @map("requested_at") @db.Timestamptz(3)
  answer        String?
  answeredAt    DateTime? @map("answered_at") @db.Timestamptz(3)
  closeNote     String?   @map("close_note")
  closedById    String?   @map("closed_by_id") @db.Uuid
  closedAt      DateTime? @map("closed_at") @db.Timestamptz(3)

  employee    Employee      @relation("SalesProofFor", fields: [employeeId], references: [id])
  log         SalesDailyLog @relation(fields: [logId], references: [id])
  requestedBy Employee      @relation("SalesProofRequestedBy", fields: [requestedById], references: [id])
  closedBy    Employee?     @relation("SalesProofClosedBy", fields: [closedById], references: [id])

  @@index([employeeId, day])
  @@index([status])
  @@map("sales_proof_requests")
}

// ---------------------------------------------------------------------------
// Module 15.7: sales commission (plan section 20 "Commission"; the approved M15.7 scope).
// ---------------------------------------------------------------------------

/// waiting_rate: paid, but no commission rule was in force on the paid day yet. included: taken into a payroll run (M8).
enum SalesCommissionStatus {
  waiting_rate
  calculated
  approved
  rejected
  held
  included

  @@map("sales_commission_status")
}

/// earner_left: the earner was no longer active when the invoice became fully paid (the Owner decides). manual: held by the
/// Director or the Finance duty, for example after a refund or a payment reversal (neither is signalled automatically).
enum SalesCommissionHoldReason {
  earner_left
  manual

  @@map("sales_commission_hold_reason")
}

/// The Owner's final-settlement decision on a leaver-held line.
enum SalesCommissionLeaverDecision {
  pay
  forfeit

  @@map("sales_commission_leaver_decision")
}

/// How a deal's eligibility was fixed: at its Won confirmation, or (a deal confirmed before the baseline) at the baseline.
enum SalesCommissionEligibilityBasis {
  won_confirmation
  legacy_baseline

  @@map("sales_commission_eligibility_basis")
}

/// What made a line: the "invoice paid" event, or the daily reconciliation (a missed event).
enum SalesCommissionLineSource {
  event
  reconciliation

  @@map("sales_commission_line_source")
}

enum SalesCommissionEventKind {
  waiting_rate
  calculated
  approved
  rejected
  held
  leaver_decided
  included

  @@map("sales_commission_event_kind")
}

/// The one M15.7 baseline (insert-only, a single row): the internal eligibility boundary. Only invoices whose completing
/// payment was posted at or after it can earn commission; the first rule starts on its business day.
model SalesCommissionBaseline {
  id          Int      @id @default(1)
  baselineAt  DateTime @map("baseline_at") @db.Timestamptz(3)
  /// The Pakistan business day of baselineAt (also a CHECK).
  businessDay DateTime @map("business_day") @db.Date
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("sales_commission_baseline")
}

/// Whether a Won deal's owner may earn commission, fixed once (insert-only): at the Won confirmation, or at the baseline
/// for a deal confirmed before it. Later department, role or status changes never change it.
model SalesCommissionEligibility {
  id             String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dealId         String                          @unique @map("deal_id") @db.Uuid
  /// The deal owner at Won confirmation (the earner if eligible).
  earnerId       String                          @map("earner_id") @db.Uuid
  eligible       Boolean
  basis          SalesCommissionEligibilityBasis
  evaluatedAt    DateTime                        @map("evaluated_at") @db.Timestamptz(3)
  /// What the rule saw (for the record): department code, role key, employment status.
  departmentCode String                          @map("department_code")
  roleKey        String                          @map("role_key")
  status         String
  createdAt      DateTime                        @default(now()) @map("created_at") @db.Timestamptz(3)

  deal   SalesDeal            @relation(fields: [dealId], references: [id])
  earner Employee             @relation(fields: [earnerId], references: [id])
  line   SalesCommissionLine?

  @@map("sales_commission_eligibility")
}

/// A version of the company commission rule (insert-only; the rule in force on a day is the latest version whose
/// effective day is on or before it). Only the Director sets it, with step-up and a reason.
model SalesCommissionRule {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  version       Int      @unique
  /// Percent of the collected PKR value, 0.01 to 100.
  ratePercent   Decimal  @map("rate_percent") @db.Decimal(5, 2)
  effectiveFrom DateTime @map("effective_from") @db.Date
  reason        String
  setById       String   @map("set_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  setBy Employee              @relation("SalesCommissionRuleSetBy", fields: [setById], references: [id])
  lines SalesCommissionLine[]

  @@index([effectiveFrom])
  @@map("sales_commission_rules")
}

/// One commission line per Won deal, from the deal's own invoice once it is fully paid by posted payments. The amount is
/// in PKR: the collected base converted with each payment's recorded exchange rate (never an invented rate).
model SalesCommissionLine {
  id                String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dealId            String                         @unique @map("deal_id") @db.Uuid
  invoiceId         String                         @unique @map("invoice_id") @db.Uuid
  /// The billing.invoice.paid outbox event this line came from (null when the reconciliation made it).
  paidEventId       String?                        @unique @map("paid_event_id") @db.Uuid
  source            SalesCommissionLineSource
  /// The deal's eligibility snapshot (eligible), fixed at Won confirmation or at the baseline.
  eligibilityId     String                         @unique @map("eligibility_id") @db.Uuid
  earnerId          String                         @map("earner_id") @db.Uuid
  /// The deal owner at Won confirmation (frozen; always the earner: no split commission).
  wonOwnerId        String                         @map("won_owner_id") @db.Uuid
  invoiceCurrency   Currency                       @map("invoice_currency")
  /// The posted allocations of the invoice, in its currency.
  collectedBase     Decimal                        @map("collected_base") @db.Decimal(14, 2)
  /// The same allocations in PKR, each at its payment's recorded exchange rate (rounded half up per allocation).
  basePkr           Decimal                        @map("base_pkr") @db.Decimal(14, 2)
  /// When the completing payment's ledger entry was posted (the invoice became fully paid); at or after the baseline.
  fullyPaidAt       DateTime                       @map("fully_paid_at") @db.Timestamptz(3)
  /// The Pakistan business day of fullyPaidAt (never the payment's own, backdatable date). The rule in force on it applies.
  paidOn            DateTime                       @map("paid_on") @db.Date
  ruleId            String?                        @map("rule_id") @db.Uuid
  ruleVersion       Int?                           @map("rule_version")
  ratePercent       Decimal?                       @map("rate_percent") @db.Decimal(5, 2)
  /// The commission, in PKR (null only while waiting for a rate).
  amount            Decimal?                       @db.Decimal(14, 2)
  currency          Currency                       @default(PKR)
  status            SalesCommissionStatus
  calculatedAt      DateTime?                      @map("calculated_at") @db.Timestamptz(3)
  holdReason        SalesCommissionHoldReason?     @map("hold_reason")
  holdNote          String?                        @map("hold_note")
  heldById          String?                        @map("held_by_id") @db.Uuid
  heldAt            DateTime?                      @map("held_at") @db.Timestamptz(3)
  approvedById      String?                        @map("approved_by_id") @db.Uuid
  approvedAt        DateTime?                      @map("approved_at") @db.Timestamptz(3)
  /// The payroll month the approval is for (M8 takes the line into the next editable run from this month on).
  payrollMonth      String?                        @map("payroll_month")
  rejectedById      String?                        @map("rejected_by_id") @db.Uuid
  rejectedAt        DateTime?                      @map("rejected_at") @db.Timestamptz(3)
  rejectReason      String?                        @map("reject_reason")
  leaverDecision    SalesCommissionLeaverDecision? @map("leaver_decision")
  leaverDecidedById String?                        @map("leaver_decided_by_id") @db.Uuid
  leaverDecidedAt   DateTime?                      @map("leaver_decided_at") @db.Timestamptz(3)
  leaverReason      String?                        @map("leaver_reason")
  includedAt        DateTime?                      @map("included_at") @db.Timestamptz(3)
  version           Int                            @default(1)
  createdAt         DateTime                       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  deal            SalesDeal                  @relation(fields: [dealId], references: [id])
  invoice         Invoice                    @relation(fields: [invoiceId], references: [id])
  earner          Employee                   @relation("SalesCommissionEarner", fields: [earnerId], references: [id])
  wonOwner        Employee                   @relation("SalesCommissionWonOwner", fields: [wonOwnerId], references: [id])
  rule            SalesCommissionRule?       @relation(fields: [ruleId], references: [id])
  eligibility     SalesCommissionEligibility @relation(fields: [eligibilityId], references: [id])
  heldBy          Employee?                  @relation("SalesCommissionHeldBy", fields: [heldById], references: [id])
  approvedBy      Employee?                  @relation("SalesCommissionApprovedBy", fields: [approvedById], references: [id])
  rejectedBy      Employee?                  @relation("SalesCommissionRejectedBy", fields: [rejectedById], references: [id])
  leaverDecidedBy Employee?                  @relation("SalesCommissionLeaverDecidedBy", fields: [leaverDecidedById], references: [id])
  events          SalesCommissionLineEvent[]

  @@index([earnerId, status])
  @@index([status])
  @@map("sales_commission_lines")
}

/// Every step of a commission line, insert-only (calculated, waiting for a rate, held, approved, rejected, leaver
/// decision, included in payroll). actorId null = the system.
model SalesCommissionLineEvent {
  id         String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lineId     String                   @map("line_id") @db.Uuid
  event      SalesCommissionEventKind
  fromStatus SalesCommissionStatus?   @map("from_status")
  toStatus   SalesCommissionStatus    @map("to_status")
  actorId    String?                  @map("actor_id") @db.Uuid
  reason     String?
  at         DateTime                 @default(now()) @db.Timestamptz(3)

  line  SalesCommissionLine @relation(fields: [lineId], references: [id])
  actor Employee?           @relation(fields: [actorId], references: [id])

  @@index([lineId, at])
  @@map("sales_commission_line_events")
}
