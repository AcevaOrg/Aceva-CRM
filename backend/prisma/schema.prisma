  createdBy     String?  @map("created_by") @db.Uuid
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy     String?  @map("updated_by") @db.Uuid

  @@map("approval_limits")
}

model FinancePeriod {
  /// 'YYYY-MM'
  month            String              @id
  status           FinancePeriodStatus @default(open)
  checklist        Json?
  closeRequestedBy String?             @map("close_requested_by") @db.Uuid
  closeRequestedAt DateTime?           @map("close_requested_at") @db.Timestamptz(3)
  closedBy         String?             @map("closed_by") @db.Uuid
  closedAt         DateTime?           @map("closed_at") @db.Timestamptz(3)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy        String?             @map("updated_by") @db.Uuid

  events FinancePeriodEvent[]

  @@map("finance_periods")
}

/// Close requested, approved, rejected, reopened (with reason). Insert-only.
model FinancePeriodEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  month     String
  action    String
  actorId   String   @map("actor_id") @db.Uuid
  reason    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  period FinancePeriod @relation(fields: [month], references: [month])

  @@index([month])
  @@map("finance_period_events")
}

/// A double-entry journal entry. Draft -> Pending approval -> Posted. A posted entry can never be edited or deleted
/// (database trigger); a mistake is fixed by a reversing entry (reversal_of_id).
model JournalEntry {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// JE-2026-0001, from a database sequence.
  number         String             @unique @default(dbgenerated("((('JE-'::text || to_char(now(), 'YYYY'::text)) || '-'::text) || lpad((nextval('journal_entry_seq'::regclass))::text, 4, '0'::text))"))
  entryDate      DateTime           @map("entry_date") @db.Date
  description    String
  source         JournalSource      @default(manual)
  /// What created it (invoice id, payroll run id...). With source and purpose, unique: nothing is posted twice.
  sourceRef      String?            @map("source_ref")
  purpose        String?
  currency       Currency           @default(PKR)
  /// PKR per 1 unit of the entry currency (1 for PKR).
  exchangeRate   Decimal            @default(1) @map("exchange_rate") @db.Decimal(18, 6)
  /// Total of the debits in PKR (= total of the credits).
  totalBase      Decimal            @default(0) @map("total_base") @db.Decimal(14, 2)
  status         JournalEntryStatus @default(draft)
  projectId      String?            @map("project_id") @db.Uuid
  /// At most one reversal that is not rejected per entry (partial unique index "journal_entries_one_live_reversal",
  /// migration 20261112230000): a rejected reversal draft does not block a new one.
  reversalOfId   String?            @map("reversal_of_id") @db.Uuid
  makerId        String             @map("maker_id") @db.Uuid
  submittedAt    DateTime?          @map("submitted_at") @db.Timestamptz(3)
  /// The approval tier the amount needed when it was submitted (a level number).
  requiredLevel  Int?               @map("required_level")
  approvedBy     String?            @map("approved_by") @db.Uuid
  postedAt       DateTime?          @map("posted_at") @db.Timestamptz(3)
  rejectedBy     String?            @map("rejected_by") @db.Uuid
  rejectedReason String?            @map("rejected_reason")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy      String?            @map("created_by") @db.Uuid
  updatedAt      DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy      String?            @map("updated_by") @db.Uuid

  project    FinanceProject?     @relation(fields: [projectId], references: [id])
  reversalOf JournalEntry?       @relation("Reversal", fields: [reversalOfId], references: [id])
  reversedBy JournalEntry[]      @relation("Reversal")
  lines      JournalLine[]
  events     JournalEntryEvent[]
  receipts   Receipt[]

  @@unique([source, sourceRef, purpose])
  @@index([entryDate])
  @@index([status])
  @@index([reversalOfId])
  @@map("journal_entries")
}

model JournalLine {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entryId     String   @map("entry_id") @db.Uuid
  lineNo      Int      @map("line_no")
  accountId   String   @map("account_id") @db.Uuid
  description String?
  /// In the entry currency.
  debit       Decimal  @default(0) @db.Decimal(14, 2)
  credit      Decimal  @default(0) @db.Decimal(14, 2)
  /// In PKR (amount x exchange rate, rounded to 2 decimals).
  baseDebit   Decimal  @default(0) @map("base_debit") @db.Decimal(14, 2)
  baseCredit  Decimal  @default(0) @map("base_credit") @db.Decimal(14, 2)
  partyId     String?  @map("party_id") @db.Uuid
  employeeId  String?  @map("employee_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  entry    JournalEntry        @relation(fields: [entryId], references: [id])
  account  LedgerAccount       @relation(fields: [accountId], references: [id])
  party    Party?              @relation(fields: [partyId], references: [id])
  employee Employee?           @relation(fields: [employeeId], references: [id])
  matches  BankStatementLine[]

  @@unique([entryId, lineNo])
  @@index([accountId])
  @@index([partyId])
  @@map("journal_lines")
}

/// Status history of an entry (created, submitted, approved, rejected, posted...). Insert-only.
model JournalEntryEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entryId   String   @map("entry_id") @db.Uuid
  action    String
  actorId   String?  @map("actor_id") @db.Uuid
  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  entry JournalEntry @relation(fields: [entryId], references: [id])

  @@index([entryId])
  @@map("journal_entry_events")
}

/// Client invoice. Paid / part paid / unpaid is calculated from posted payment allocations, never stored.
model Invoice {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// INV-2026-0001, from a database sequence.
  number         String    @unique @default(dbgenerated("((('INV-'::text || to_char(now(), 'YYYY'::text)) || '-'::text) || lpad((nextval('invoice_seq'::regclass))::text, 4, '0'::text))"))
  partyId        String    @map("party_id") @db.Uuid
  issueDate      DateTime  @map("issue_date") @db.Date
  dueDate        DateTime  @map("due_date") @db.Date
  currency       Currency  @default(PKR)
  exchangeRate   Decimal   @default(1) @map("exchange_rate") @db.Decimal(18, 6)
  total          Decimal   @db.Decimal(14, 2)
  projectId      String?   @map("project_id") @db.Uuid
  notes          String?
  journalEntryId String?   @unique @map("journal_entry_id") @db.Uuid
  cancelledAt    DateTime? @map("cancelled_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy      String?   @map("created_by") @db.Uuid
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy      String?   @map("updated_by") @db.Uuid

  // ---- Module 13 (customer billing) extends this table; Module 9 still writes every ledger entry. ----
  /// draft (no ledger entry, temporary DRAFT- number) -> issued (INV- number, entry submitted) -> cancelled.
  /// Paid / part paid / overdue are still calculated, never stored. Rows that existed before M13 are issued.
  status            InvoiceStatus @default(issued)
  kind              InvoiceKind   @default(one_time)
  termsDays         Int?          @map("terms_days")
  /// The billing period this invoice covers (recurring and rental invoices).
  periodStart       DateTime?     @map("period_start") @db.Date
  periodEnd         DateTime?     @map("period_end") @db.Date
  recurringRuleId   String?       @map("recurring_rule_id") @db.Uuid
  /// Reminder days relative to the due date (-3 = 3 days before).
  reminderOffsets   Int[]         @default([]) @map("reminder_offsets")
  /// The staff member reminded about this invoice.
  assignedToId      String?       @map("assigned_to_id") @db.Uuid
  /// M15 connection point: a confirmed Won deal creates exactly one draft (unique).
  sourceDealNumber  String?       @unique @map("source_deal_number")
  sourceDealOwnerId String?       @map("source_deal_owner_id") @db.Uuid
  /// The client's retry key: the same create request never makes a second invoice.
  requestKey        String?       @unique @map("request_key")
  issuedAt          DateTime?     @map("issued_at") @db.Timestamptz(3)
  issuedBy          String?       @map("issued_by") @db.Uuid
  emailedAt         DateTime?     @map("emailed_at") @db.Timestamptz(3)
  cancelledBy       String?       @map("cancelled_by") @db.Uuid
  cancelReason      String?       @map("cancel_reason")
  /// The reversing entry made when an invoice whose entry was posted is cancelled.
  cancelEntryId     String?       @unique @map("cancel_entry_id") @db.Uuid
  /// When the "invoice paid" and "invoice overdue" events were sent (each once).
  paidEventAt       DateTime?     @map("paid_event_at") @db.Timestamptz(3)
  overdueEventAt    DateTime?     @map("overdue_event_at") @db.Timestamptz(3)

  party         Party                  @relation(fields: [partyId], references: [id])
  lines         InvoiceLine[]
  allocations   PaymentAllocation[]
  recurringRule RecurringBillingRule?  @relation(fields: [recurringRuleId], references: [id])
  assignedTo    Employee?              @relation("InvoiceAssignee", fields: [assignedToId], references: [id])
  reminders     InvoiceReminder[]
  emails        BillingCustomerEmail[]

  @@unique([recurringRuleId, periodStart])
  @@index([partyId])
  @@index([status, dueDate])
  @@map("invoices")
}

model InvoiceLine {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId   String  @map("invoice_id") @db.Uuid
  lineNo      Int     @map("line_no")
  description String
  quantity    Decimal @db.Decimal(12, 2)
  unitPrice   Decimal @map("unit_price") @db.Decimal(14, 2)
  amount      Decimal @db.Decimal(14, 2)
  /// Income account credited.
  accountId   String  @map("account_id") @db.Uuid

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@unique([invoiceId, lineNo])
  @@map("invoice_lines")
}

/// Vendor bill or expense, with the receipt uploaded.
model Bill {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  number         String    @unique @default(dbgenerated("((('BILL-'::text || to_char(now(), 'YYYY'::text)) || '-'::text) || lpad((nextval('bill_seq'::regclass))::text, 4, '0'::text))"))
  partyId        String    @map("party_id") @db.Uuid
  vendorRef      String?   @map("vendor_ref")
  billDate       DateTime  @map("bill_date") @db.Date
  dueDate        DateTime  @map("due_date") @db.Date
  currency       Currency  @default(PKR)
  exchangeRate   Decimal   @default(1) @map("exchange_rate") @db.Decimal(18, 6)
  total          Decimal   @db.Decimal(14, 2)
  /// Expense (or asset) account debited.
  accountId      String    @map("account_id") @db.Uuid
  projectId      String?   @map("project_id") @db.Uuid
  description    String
  journalEntryId String?   @unique @map("journal_entry_id") @db.Uuid
  cancelledAt    DateTime? @map("cancelled_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy      String?   @map("created_by") @db.Uuid
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy      String?   @map("updated_by") @db.Uuid

  party       Party               @relation(fields: [partyId], references: [id])
  allocations PaymentAllocation[]
  receipts    Receipt[]

  @@index([partyId])
  @@map("bills")
}

/// Money received from a client or paid to a vendor through a bank account.
model Payment {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  direction      PaymentDirection
  partyId        String           @map("party_id") @db.Uuid
  bankAccountId  String           @map("bank_account_id") @db.Uuid
  paymentDate    DateTime         @map("payment_date") @db.Date
  currency       Currency         @default(PKR)
  exchangeRate   Decimal          @default(1) @map("exchange_rate") @db.Decimal(18, 6)
  amount         Decimal          @db.Decimal(14, 2)
  method         String?
  reference      String?
  journalEntryId String?          @unique @map("journal_entry_id") @db.Uuid
  /// M13: the client's retry key, so recording the same payment twice never makes a second one.
  requestKey     String?          @unique @map("request_key")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy      String?          @map("created_by") @db.Uuid

  party       Party               @relation(fields: [partyId], references: [id])
  allocations PaymentAllocation[]

  @@index([partyId])
  @@map("payments")
}

model PaymentAllocation {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId String   @map("payment_id") @db.Uuid
  invoiceId String?  @map("invoice_id") @db.Uuid
  billId    String?  @map("bill_id") @db.Uuid
  amount    Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  payment Payment  @relation(fields: [paymentId], references: [id])
  invoice Invoice? @relation(fields: [invoiceId], references: [id])
  bill    Bill?    @relation(fields: [billId], references: [id])

  @@index([invoiceId])
  @@index([billId])
  @@map("payment_allocations")
}

/// Receipt file metadata (the file lives in private storage).
model Receipt {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  billId           String?   @map("bill_id") @db.Uuid
  entryId          String?   @map("entry_id") @db.Uuid
  storageKey       String    @unique @map("storage_key")
  originalFilename String    @map("original_filename")
  mimeType         String    @map("mime_type")
  sizeBytes        Int       @map("size_bytes")
  sha256           String
  archivedAt       DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy        String?   @map("created_by") @db.Uuid

  bill  Bill?         @relation(fields: [billId], references: [id])
  entry JournalEntry? @relation(fields: [entryId], references: [id])

  @@index([billId])
  @@index([entryId])
  @@map("receipts")
}

model BankStatementImport {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bankAccountId String   @map("bank_account_id") @db.Uuid
  filename      String
  sha256        String
  lineCount     Int      @map("line_count")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy     String?  @map("created_by") @db.Uuid

  lines BankStatementLine[]

  @@unique([bankAccountId, sha256])
  @@map("bank_statement_imports")
}

model BankStatementLine {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  importId      String    @map("import_id") @db.Uuid
  lineNo        Int       @map("line_no")
  valueDate     DateTime  @map("value_date") @db.Date
  description   String
  /// Positive = money in, negative = money out, in the bank account's currency.
  amount        Decimal   @db.Decimal(14, 2)
  reference     String?
  matchedLineId String?   @unique @map("matched_line_id") @db.Uuid
  matchedBy     String?   @map("matched_by") @db.Uuid
  matchedAt     DateTime? @map("matched_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  statement   BankStatementImport @relation(fields: [importId], references: [id])
  matchedLine JournalLine?        @relation(fields: [matchedLineId], references: [id])

  @@unique([importId, lineNo])
  @@map("bank_statement_lines")
}

/// Small finance settings until Module 12 (one row, id = 1). Development defaults; management sets real values.
model FinanceSetting {
  id                    Int      @id @default(1)
  /// Approving an entry whose PKR total is above this asks for the password and code again ("large entries", plan section 16).
  stepUpAbove           Decimal  @map("step_up_above") @db.Decimal(14, 2)
  /// First month of the finance year (7 = July, Pakistan's normal tax year).
  financeYearStartMonth Int      @map("finance_year_start_month")
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy             String?  @map("updated_by") @db.Uuid

  @@map("finance_settings")
}

// ============================================================================================================
// Cycle 3 shared foundation: outbox readers, notifications (minimal Module 12 core), module-owned settings.
// ============================================================================================================

/// A module that reads outbox events. It sees only events written after it was first registered (started_at),
/// so switching a new reader on never replays the past.
model OutboxConsumer {
  name      String   @id
  startedAt DateTime @default(now()) @map("started_at") @db.Timestamptz(3)

  consumptions OutboxConsumption[]

  @@map("outbox_consumers")
}

enum OutboxConsumptionStatus {
  done
  failed
  dead
  skipped

  @@map("outbox_consumption_status")
}

/// One row per reader and event: handled (done), to be tried again (failed), given up after the last attempt (dead) or
/// unreadable for this reader (skipped). Unique per reader and event, so each reader processes each event once.
model OutboxConsumption {
  id            String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  consumer      String
  eventId       String                  @map("event_id") @db.Uuid
  status        OutboxConsumptionStatus
  attempts      Int                     @default(0)
  /// Never message bodies or personal data: the error class and a short message only.
  lastError     String?                 @map("last_error")
  nextAttemptAt DateTime?               @map("next_attempt_at") @db.Timestamptz(3)
  processedAt   DateTime?               @map("processed_at") @db.Timestamptz(3)
  createdAt     DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  reader OutboxConsumer @relation(fields: [consumer], references: [name])
  event  OutboxEvent    @relation(fields: [eventId], references: [id])

  @@unique([consumer, eventId])
  @@index([consumer, status, nextAttemptAt])
  @@map("outbox_consumptions")
}

/// An in-app notification (the bell). One per recipient and dedupe key, so a retried event never creates a second one.
model Notification {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientId   String    @map("recipient_id") @db.Uuid
  /// One of notificationTypeSchema (packages/contracts/src/notifications.ts).
  type          String
  title         String
  body          String?
  /// An app path such as /approvals (never an external URL).
  link          String?
  /// Approvals and security alerts: always shown and always emailed (plan section 17).
  essential     Boolean
  dedupeKey     String    @map("dedupe_key")
  sourceEventId String?   @map("source_event_id") @db.Uuid
  readAt        DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  recipient  Employee               @relation(fields: [recipientId], references: [id])
  deliveries NotificationDelivery[]

  @@unique([recipientId, dedupeKey])
  @@index([recipientId, createdAt])
  @@map("notifications")
}

/// A person's choices. Only emails can be turned off, and never for the essential types (database rule too).
model NotificationPreference {
  employeeId   String   @id @map("employee_id") @db.Uuid
  /// Notification types whose email this person turned off.
  emailOff     String[] @default([]) @map("email_off")
  /// Stored for the daily summary email (Module 12); the summary itself is not sent yet.
  dailySummary Boolean  @default(true) @map("daily_summary")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("notification_preferences")
}

enum NotificationDeliveryStatus {
  pending
  sending
  sent
  failed
  skipped
  /// The server stopped while sending: the outcome is unknown, so it is never sent again automatically.
  unknown

  @@map("notification_delivery_status")
}

/// One email per notification at most (unique), sent by the delivery worker with retries.
model NotificationDelivery {
  id             String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notificationId String                     @map("notification_id") @db.Uuid
  channel        String                     @default("email")
  status         NotificationDeliveryStatus @default(pending)
  /// Why it was skipped (turned_off, no_email, recipient_left), or the last error class.
  note           String?
  toAddress      String?                    @map("to_address")
  attempts       Int                        @default(0)
  nextAttemptAt  DateTime                   @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  claimedAt      DateTime?                  @map("claimed_at") @db.Timestamptz(3)
  sentAt         DateTime?                  @map("sent_at") @db.Timestamptz(3)
  createdAt      DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  notification Notification @relation(fields: [notificationId], references: [id])

  @@unique([notificationId, channel])
  @@index([status, nextAttemptAt])
  @@map("notification_deliveries")
}

/// Settings owned by one module (the pattern until Module 12's settings screen exists). The value is validated by the
/// module's own schema; version gives optimistic locking; every change is audited.
model ModuleSetting {
  module    String   @id
  value     Json
  version   Int      @default(1)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy String?  @map("updated_by") @db.Uuid

  @@map("module_settings")
}

// ============================================================================================================
// Module 13: customer billing, subscriptions and renewal management (plan section 18).
// Invoices, invoice lines, payments and the ledger stay in Module 9 (the tables above); these tables add the
// billing life cycle around them. Only Module 9 writes money.
// ============================================================================================================

enum InvoiceStatus {
  draft
  issued
  cancelled

  @@map("invoice_status")
}

enum InvoiceKind {
  one_time
  recurring
  rental

  @@map("invoice_kind")
}

enum BillingPeriod {
  monthly
  quarterly
  yearly

  @@map("billing_period")
}

enum RecurringRuleStatus {
  active
  ended

  @@map("recurring_rule_status")
}

enum ReminderAudience {
  customer
  staff

  @@map("reminder_audience")
}

enum ReminderStatus {
  scheduled
  sent
  skipped

  @@map("reminder_status")
}

enum CustomerEmailStatus {
  pending
  sending
  sent
  failed
  skipped
  unknown

  @@map("customer_email_status")
}

enum SubscriptionStatus {
  active
  cancelled

  @@map("subscription_status")
}

enum DealHandoverStatus {
  drafted
  needs_client

  @@map("deal_handover_status")
}

/// A confirmed Won deal received from Module 15 (one row per deal number). drafted = its draft invoice exists;
/// needs_client = several clients have exactly its client name, and Finance chooses the right one (never chosen silently).
model DealHandover {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dealNumber        String             @unique @map("deal_number")
  /// The event payload (client, service, value, currency, owner).
  payload           Json
  status            DealHandoverStatus
  candidatePartyIds String[]           @map("candidate_party_ids") @db.Uuid
  invoiceId         String?            @unique @map("invoice_id") @db.Uuid
  sourceEventId     String?            @map("source_event_id") @db.Uuid
  resolvedBy        String?            @map("resolved_by") @db.Uuid
  resolvedAt        DateTime?          @map("resolved_at") @db.Timestamptz(3)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status])
  @@map("deal_handovers")
}

enum SubscriptionPeriod {
  monthly
  quarterly
  yearly
  usage

  @@map("subscription_period")
}

enum RenewalEventKind {
  alert
  renewed
  changed
  cancelled

  @@map("renewal_event_kind")
}

/// A client's billing details (the client itself is the Module 9 party).
model BillingProfile {
  partyId         String   @id @map("party_id") @db.Uuid
  contactName     String?  @map("contact_name")
  termsDays       Int      @map("terms_days")
  taxId           String?  @map("tax_id")
  notes           String?
  /// A client created automatically from a Won deal: Finance reviews it before its invoice can be issued.
  needsReview     Boolean  @default(false) @map("needs_review")
  createdFromDeal String?  @map("created_from_deal")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy       String?  @map("created_by") @db.Uuid
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy       String?  @map("updated_by") @db.Uuid

  party Party @relation(fields: [partyId], references: [id])

  @@map("billing_profiles")
}

/// A recurring or rental billing rule. Each period it creates one draft invoice (unique per rule and period start)
/// for the finance duty person to check and issue.
model RecurringBillingRule {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partyId         String              @map("party_id") @db.Uuid
  kind            InvoiceKind
  period          BillingPeriod
  currency        Currency
  /// [{ description, quantity, unitPrice, accountId }]
  lines           Json
  termsDays       Int                 @map("terms_days")
  reminderOffsets Int[]               @map("reminder_offsets")
  assignedToId    String?             @map("assigned_to_id") @db.Uuid
  notes           String?
  startDate       DateTime            @map("start_date") @db.Date
  /// The last day billed; null = until stopped.
  endDate         DateTime?           @map("end_date") @db.Date
  /// The start of the next period to bill.
  nextPeriodStart DateTime            @map("next_period_start") @db.Date
  status          RecurringRuleStatus @default(active)
  endedAt         DateTime?           @map("ended_at") @db.Timestamptz(3)
  endedBy         String?             @map("ended_by") @db.Uuid
  endReason       String?             @map("end_reason")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy       String?             @map("created_by") @db.Uuid
  updatedAt       DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy       String?             @map("updated_by") @db.Uuid

  party      Party     @relation(fields: [partyId], references: [id])
  assignedTo Employee? @relation("RecurringRuleAssignee", fields: [assignedToId], references: [id])
  invoices   Invoice[]

  @@index([status, nextPeriodStart])
  @@map("recurring_billing_rules")
}

/// Reminder history: one row per invoice, reminder day and audience (unique), so a reminder is never sent twice.
model InvoiceReminder {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId       String           @map("invoice_id") @db.Uuid
  offsetDays      Int              @map("offset_days")
  audience        ReminderAudience
  scheduledFor    DateTime         @map("scheduled_for") @db.Date
  status          ReminderStatus   @default(scheduled)
  /// Why it was skipped (paid, cancelled, customer emails off...).
  reason          String?
  sentAt          DateTime?        @map("sent_at") @db.Timestamptz(3)
  notificationId  String?          @map("notification_id") @db.Uuid
  customerEmailId String?          @map("customer_email_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@unique([invoiceId, offsetDays, audience])
  @@index([status, scheduledFor])
  @@map("invoice_reminders")
}

/// Emails to customers (the invoice itself and reminders), sent by a worker with retries. Unique per dedupe key.
model BillingCustomerEmail {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId      String              @map("invoice_id") @db.Uuid
  /// invoice or reminder
  kind           String
  reminderOffset Int?                @map("reminder_offset")
  toAddress      String              @map("to_address")
  dedupeKey      String              @unique @map("dedupe_key")
  status         CustomerEmailStatus @default(pending)
  attempts       Int                 @default(0)
  nextAttemptAt  DateTime            @map("next_attempt_at") @db.Timestamptz(3)
  sentAt         DateTime?           @map("sent_at") @db.Timestamptz(3)
  lastError      String?             @map("last_error")
  note           String?
  createdBy      String?             @map("created_by") @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([status, nextAttemptAt])
  @@index([invoiceId])
  @@map("billing_customer_emails")
}

/// Aceva's own tools and services (Apollo, domains, mailboxes, AI tools, hosting, APIs...).
model Subscription {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// SUB-2026-0001, from a database sequence.
  number          String             @unique @default(dbgenerated("((('SUB-'::text || to_char(now(), 'YYYY'::text)) || '-'::text) || lpad((nextval('subscription_seq'::regclass))::text, 4, '0'::text))"))
  vendor          String
  product         String
  category        String
  /// The person responsible: renewal alerts go to them.
  ownerId         String             @map("owner_id") @db.Uuid
  plan            String
  cost            Decimal            @db.Decimal(14, 2)
  currency        Currency
  period          SubscriptionPeriod
  renewalDate     DateTime           @map("renewal_date") @db.Date
  alertDaysBefore Int                @map("alert_days_before")
  seats           Int?
  usageMetric     String?            @map("usage_metric")
  usageUnit       String?            @map("usage_unit")
  usageLimit      Decimal?           @map("usage_limit") @db.Decimal(18, 4)
  notes           String?
  status          SubscriptionStatus @default(active)
  cancelledAt     DateTime?          @map("cancelled_at") @db.Timestamptz(3)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy       String?            @map("created_by") @db.Uuid
  updatedAt       DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy       String?            @map("updated_by") @db.Uuid

  owner         Employee                   @relation("SubscriptionOwner", fields: [ownerId], references: [id])
  renewalEvents SubscriptionRenewalEvent[]
  usage         UsageSnapshot[]
  costs         SubscriptionCost[]

  @@index([status, renewalDate])
  @@map("subscriptions")
}

/// Renewal alerts and decisions (renewed, changed, cancelled). Insert-only. One alert per subscription and renewal date.
model SubscriptionRenewalEvent {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscriptionId String           @map("subscription_id") @db.Uuid
  kind           RenewalEventKind
  /// The renewal date this alert or decision is about.
  renewalDate    DateTime         @map("renewal_date") @db.Date
  newRenewalDate DateTime?        @map("new_renewal_date") @db.Date
  oldCost        Decimal?         @map("old_cost") @db.Decimal(14, 2)
  newCost        Decimal?         @map("new_cost") @db.Decimal(14, 2)
  oldPlan        String?          @map("old_plan")
  newPlan        String?          @map("new_plan")
  note           String?
  actorId        String?          @map("actor_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([subscriptionId])
  @@map("subscription_renewal_events")
}

/// A usage reading. Entered by hand (no provider API is connected yet); a cost on it is always an estimate. Insert-only.
model UsageSnapshot {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscriptionId String   @map("subscription_id") @db.Uuid
  readingDate    DateTime @map("reading_date") @db.Date
  used           Decimal  @db.Decimal(18, 4)
  /// The limit at the time of the reading (defaults to the subscription's limit).
  limit          Decimal? @db.Decimal(18, 4)
  estimatedCost  Decimal? @map("estimated_cost") @db.Decimal(14, 2)
  /// manual only for now; api is reserved for a provider connection.
  source         String   @default("manual")
  note           String?
  enteredBy      String?  @map("entered_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([subscriptionId, readingDate])
  @@map("usage_snapshots")
}

/// What a subscription cost in a month. Estimated unless it is backed by a Module 9 bill or the provider's invoice reference.
model SubscriptionCost {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscriptionId String   @map("subscription_id") @db.Uuid
  /// YYYY-MM
  month          String
  amount         Decimal  @db.Decimal(14, 2)
  currency       Currency
  estimated      Boolean
  billId         String?  @map("bill_id") @db.Uuid
  reference      String?
  note           String?
  enteredBy      String?  @map("entered_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy      String?  @map("updated_by") @db.Uuid

  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@unique([subscriptionId, month])
  @@map("subscription_costs")
}

// ============================================================================================================
// Module 14, part 1 (M14.1): conversations and messages (plan section 19).
// Message text lives only in messages.body and message_revisions.body. It is never copied into the audit log, the
// outbox or the application logs. Nothing here is hard-deleted (database triggers); retention periods are not decided
// yet, so nothing is deleted automatically.
// ============================================================================================================

enum ConversationKind {
  dm
  group
  channel

  @@map("conversation_kind")
}

/// What a channel is for: a department (members follow the employee records) or a project (members managed by hand).
enum ChannelScope {
  department
  project

  @@map("channel_scope")
}

enum ConversationRole {
  member
  moderator

  @@map("conversation_role")
}

/// Why an older version of a message was kept: the author edited it, the author deleted it, or a moderator removed it.
enum MessageRevisionKind {
  edited
  deleted
  removed

  @@map("message_revision_kind")
}

/// A direct message (two people), a group, or a department or project channel.
model Conversation {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind          ConversationKind
  channelScope  ChannelScope?    @map("channel_scope")
  name          String?
  topic         String?
  /// Department channels: the department whose current employees (and head) are members.
  departmentId  String?          @map("department_id") @db.Uuid
  /// Project channels: a free-text project name and code (Module 5 projects do not exist yet; M9 finance projects are not used).
  projectName   String?          @map("project_name")
  projectCode   String?          @map("project_code")
  /// DMs only: the two people's ids in sorted order, so the same pair can never get a second DM (unique).
  dmKey         String?          @unique @map("dm_key")
  /// The last sequence number given to a message here. Raised in the same transaction as the message insert, under
  /// this row's lock, so concurrent sends are numbered one after another and a rolled-back send leaves no gap.
  lastSeq       Int              @default(0) @map("last_seq")
  lastMessageAt DateTime?        @map("last_message_at") @db.Timestamptz(3)
  createdById   String           @map("created_by_id") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @default(now()) @map("updated_at") @db.Timestamptz(3)
  archivedAt    DateTime?        @map("archived_at") @db.Timestamptz(3)
  archivedById  String?          @map("archived_by_id") @db.Uuid

  department       Department?               @relation(fields: [departmentId], references: [id])
  members          ConversationMember[]
  reads            ConversationRead[]
  messages         Message[]
  pins             PinnedMessage[]
  departmentAccess DepartmentChannelAccess[]

  @@index([departmentId])
  @@index([kind])
  @@map("conversations")
}

/// People added to a conversation by hand (DM and group members, project channel members, moderators, and anyone added
/// to a department channel beyond its department). One row per person and conversation; leaving sets left_at.
model ConversationMember {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String           @map("conversation_id") @db.Uuid
  employeeId     String           @map("employee_id") @db.Uuid
  role           ConversationRole @default(member)
  addedById      String?          @map("added_by_id") @db.Uuid
  /// The conversation's last message number when this person was added (or added again): they see only later messages.
  joinedSeq      Int              @default(0) @map("joined_seq")
  joinedAt       DateTime         @default(now()) @map("joined_at") @db.Timestamptz(3)
  leftAt         DateTime?        @map("left_at") @db.Timestamptz(3)
  removedById    String?          @map("removed_by_id") @db.Uuid
  updatedAt      DateTime         @default(now()) @map("updated_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id])
  employee     Employee     @relation(fields: [employeeId], references: [id])

  @@unique([conversationId, employeeId])
  @@index([employeeId])
  @@map("conversation_members")
}

/// How far each person has received and read a conversation (sequence numbers). Kept apart from the member rows because
/// department channel members are worked out from the employee records and have no member row.
model ConversationRead {
  conversationId   String   @map("conversation_id") @db.Uuid
  employeeId       String   @map("employee_id") @db.Uuid
  lastDeliveredSeq Int      @default(0) @map("last_delivered_seq")
  lastReadSeq      Int      @default(0) @map("last_read_seq")
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id])
  employee     Employee     @relation(fields: [employeeId], references: [id])

  @@id([conversationId, employeeId])
  @@index([employeeId])
  @@map("conversation_reads")
}

/// When someone became a member of a department channel through the employee records (hired into the department,
/// moved into it, or made its head): they see only messages after from_seq. Written by database triggers on employees
/// and departments, so every way of changing a department is covered. No row = a member since before the channel existed.
model DepartmentChannelAccess {
  conversationId String   @map("conversation_id") @db.Uuid
  employeeId     String   @map("employee_id") @db.Uuid
  fromSeq        Int      @map("from_seq")
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id])
  employee     Employee     @relation(fields: [employeeId], references: [id])

  @@id([conversationId, employeeId])
  @@index([employeeId])
  @@map("department_channel_access")
}

/// One message. seq is unique per conversation and has no gaps; client_key is the sender's retry key (unique per author).
/// A deleted or removed message keeps its row as a placeholder with an empty body; the text is kept in message_revisions.
model Message {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String               @map("conversation_id") @db.Uuid
  seq            Int
  authorId       String               @map("author_id") @db.Uuid
  /// A reply: the top-level message of the same conversation it answers.
  parentId       String?              @map("parent_id") @db.Uuid
  /// Plain text, at most 4,000 characters. Empty only once deleted.
  body           String
  clientKey      String               @map("client_key") @db.Uuid
  /// SHA-256 of what was first sent with this retry key, so a retry with different content is refused.
  requestHash    String               @map("request_hash")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  editedAt       DateTime?            @map("edited_at") @db.Timestamptz(3)
  /// How many older versions are kept in message_revisions.
  revision       Int                  @default(0)
  deletedAt      DateTime?            @map("deleted_at") @db.Timestamptz(3)
  deletedById    String?              @map("deleted_by_id") @db.Uuid
  deletedAs      MessageRevisionKind? @map("deleted_as")

  conversation Conversation      @relation(fields: [conversationId], references: [id])
  author       Employee          @relation("MessageAuthor", fields: [authorId], references: [id])
  parent       Message?          @relation("MessageReplies", fields: [parentId], references: [id])
  replies      Message[]         @relation("MessageReplies")
  revisions    MessageRevision[]
  reactions    MessageReaction[]
  mentions     MessageMention[]
  saves        SavedMessage[]
  pin          PinnedMessage?

  @@unique([conversationId, seq])
  @@unique([authorId, clientKey])
  @@index([conversationId, parentId, seq])
  @@index([authorId, createdAt])
  @@map("messages")
}

/// Older versions of a message (insert-only). Kept in the database for the retention period, never shown in the app.
model MessageRevision {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId   String              @map("message_id") @db.Uuid
  revision    Int
  kind        MessageRevisionKind
  /// The text as it was before this change.
  body        String
  changedById String              @map("changed_by_id") @db.Uuid
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  message Message @relation(fields: [messageId], references: [id])

  @@unique([messageId, revision])
  @@map("message_revisions")
}

/// Someone mentioned in a message (by Emp-ID; always a member of the conversation).
model MessageMention {
  messageId  String   @map("message_id") @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  message  Message  @relation(fields: [messageId], references: [id])
  employee Employee @relation("MessageMentioned", fields: [employeeId], references: [id])

  @@id([messageId, employeeId])
  @@index([employeeId])
  @@map("message_mentions")
}

model MessageReaction {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId  String   @map("message_id") @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  emoji      String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  message  Message  @relation(fields: [messageId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([messageId, employeeId, emoji])
  @@map("message_reactions")
}

/// A person's own saved messages (private to them).
model SavedMessage {
  employeeId String   @map("employee_id") @db.Uuid
  messageId  String   @map("message_id") @db.Uuid
  savedAt    DateTime @default(now()) @map("saved_at") @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id])
  message  Message  @relation(fields: [messageId], references: [id])

  @@id([employeeId, messageId])
  @@index([employeeId, savedAt])
  @@map("saved_messages")
}

/// A message pinned in its conversation (once).
model PinnedMessage {
  messageId      String   @id @map("message_id") @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  pinnedById     String   @map("pinned_by_id") @db.Uuid
  pinnedAt       DateTime @default(now()) @map("pinned_at") @db.Timestamptz(3)

  message      Message      @relation(fields: [messageId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
  @@map("pinned_messages")
}
