# Copy this file to ".env" and fill in your own values. NEVER commit ".env".
# The values below match the local services in docker-compose.yml (repository root). They are obvious local
# placeholders, not secrets: if you install PostgreSQL and Redis yourself, use your own passwords here.

NODE_ENV=development
PORT=4000

# Allowed browser origin for the Next.js frontend (CORS).
CORS_ORIGIN=http://localhost:3000

# PostgreSQL. The app uses its own user (aceva_app), not "postgres".
DATABASE_URL=postgresql://aceva_app:local-only-db-password@127.0.0.1:5432/aceva_dev
# Used only by "prisma migrate dev" to check migrations in a throwaway database.
SHADOW_DATABASE_URL=postgresql://aceva_app:local-only-db-password@127.0.0.1:5432/aceva_shadow
# Used by automated tests, which EMPTY AND REBUILD it on every run. It must be an approved disposable test database
# (exact name, on this computer): aceva_m15_test, or a database named in ACEVA_APPROVED_TEST_DATABASES. Anything else is
# refused before it is touched (backend/test/helpers/db-guard.ts). Never point it at aceva_dev, aceva_shadow or
# aceva_realtime_dev.
TEST_DATABASE_URL=postgresql://aceva_app:local-only-db-password@127.0.0.1:5432/aceva_m15_test
# Optional, comma-separated: other disposable test databases this computer may reset (for example a throw-away aceva_test).
# ACEVA_APPROVED_TEST_DATABASES=
# Optional: a Redis key prefix of its own for this test run (the default is aceva:test:).
# TEST_REDIS_PREFIX=aceva:m15test:

# Private file storage (documents and photos). Keep it OUTSIDE the web root and out of Git.
# The default below is backend/.local-storage (ignored by Git). Any absolute path on your computer works too.
FILE_STORAGE_ROOT=./.local-storage
# Module 14 file scanning: the ClamAV daemon (docs/SETUP.md). Files stay unopenable while it cannot be reached.
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310

# --- M2: login and sessions ---
# Redis holds the fast copy of every session. Local: the redis service in docker-compose.yml (or your own Redis).
# Managed alternative for production: Upstash or a server install.
REDIS_URL=redis://:local-only-redis-password@127.0.0.1:6379
# 32 random bytes, base64. Encrypts 2FA secrets, CNIC and bank numbers in the database. The app refuses to start until
# you replace CHANGE_ME. Create one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=CHANGE_ME
# Module 15.4: the do-not-contact list's own key (32 random bytes, base64; NOT the key above). The list keeps only a keyed
# hash of each email, so this key can never be thrown away while entries made with it exist. To rotate: put the new key
# here with a new SALES_DNC_HMAC_KEY_ID and move the old one to SALES_DNC_HMAC_PREVIOUS_KEYS ("id:key;id:key").
# Required in production. Without it, adding or importing leads with an email and the list itself are refused.
# Create one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# SALES_DNC_HMAC_KEY=
# SALES_DNC_HMAC_KEY_ID=v1
# SALES_DNC_HMAC_PREVIOUS_KEYS=
# Link base in password-reset and welcome emails
APP_URL=http://localhost:3000
# Email: local development uses Mailpit (docker-compose.yml, inbox at http://127.0.0.1:8025).
# Production: your real SMTP details (never commit them).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
#SMTP_USER=
#SMTP_PASSWORD=
MAIL_FROM=Aceva <no-reply@acevatech.com>
# Argon2id cost (defaults are OWASP-level; lower values only for local development)
#ARGON2_MEMORY_KIB=65536
#ARGON2_TIME_COST=3
# Number of reverse proxies in front of the API (production behind Nginx: 1)
#TRUST_PROXY=0

# --- M4: activity tracking ---
# Approximate city from the internet address, from a LOCAL list of address ranges (no outside GeoIP service is ever
# called; never GPS). Format: "range/prefix=City; ...". Empty: every city is unknown. For checking on this computer,
# 127.0.0.0/8 (and the IPv6 loopback ::1) can be given a city, for example:
#GEOIP_RANGES=127.0.0.0/8=Karachi
GEOIP_RANGES=
# How often (milliseconds) the outbox dispatcher hands new events to their consumers (activity records from logins,
# security alerts, alert emails; from Module 5 also task mails, repeating tasks and the leaver hand-over).
# 0 switches it off (the automated tests do that). Default 5000.
#OUTBOX_DISPATCH_INTERVAL_MS=5000
# Build the nightly activity summaries (00:15 Pakistan time, catching up the last 7 days after downtime): on or off.
#ACTIVITY_SUMMARY_SCHEDULE=on
