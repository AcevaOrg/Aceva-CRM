# Copy this file to ".env" and fill in your own values. NEVER commit ".env".
# The values below match the local services in docker-compose.yml (repository root). They are obvious local
# placeholders, not secrets: if you install PostgreSQL and Redis yourself, use your own passwords here.

NODE_ENV=development
PORT=4000

# Allowed browser origin for the Next.js frontend (CORS).
CORS_ORIGIN=http://localhost:3000

# PostgreSQL. The app uses its own user (aceva_app), not "postgres".
DATABASE_URL=postgresql://aceva_app:local-only-db-password@127.0.0.1:5432/aceva_dev
# Used only by "prisma migrate dev" to check migrations in a throwaway database.
SHADOW_DATABASE_URL=postgresql://aceva_app:local-only-db-password@127.0.0.1:5432/aceva_shadow
# Used by automated tests. Must be a different database from DATABASE_URL, and its name must contain "test".
TEST_DATABASE_URL=postgresql://aceva_app:local-only-db-password@127.0.0.1:5432/aceva_test

# Private file storage (documents and photos). Keep it OUTSIDE the web root and out of Git.
# The default below is backend/.local-storage (ignored by Git). Any absolute path on your computer works too.
FILE_STORAGE_ROOT=./.local-storage

# --- M2: login and sessions ---
# Redis holds the fast copy of every session. Local: the redis service in docker-compose.yml (or your own Redis).
# Managed alternative for production: Upstash or a server install.
REDIS_URL=redis://:local-only-redis-password@127.0.0.1:6379
# 32 random bytes, base64. Encrypts 2FA secrets, CNIC and bank numbers in the database. The app refuses to start until
# you replace CHANGE_ME. Create one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=CHANGE_ME
# Link base in password-reset and welcome emails
APP_URL=http://localhost:3000
# Email: local development uses Mailpit (docker-compose.yml, inbox at http://127.0.0.1:8025).
# Production: your real SMTP details (never commit them).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
#SMTP_USER=
#SMTP_PASSWORD=
MAIL_FROM=Aceva <no-reply@acevatech.com>
# Argon2id cost (defaults are OWASP-level; lower values only for local development)
#ARGON2_MEMORY_KIB=65536
#ARGON2_TIME_COST=3
# Number of reverse proxies in front of the API (production behind Nginx: 1)
#TRUST_PROXY=0
