# Copy this file to ".env" and fill in your own values. NEVER commit ".env".

NODE_ENV=development
PORT=4000

# Allowed browser origin for the Next.js frontend (CORS).
CORS_ORIGIN=http://localhost:3000

# PostgreSQL (local Windows install). The app uses a limited user, not "postgres".
DATABASE_URL=postgresql://aceva_app:CHANGE_ME@localhost:5432/aceva_dev
# Used only by "prisma migrate dev" to check migrations in a throwaway database.
SHADOW_DATABASE_URL=postgresql://aceva_app:CHANGE_ME@localhost:5432/aceva_shadow
# Used by automated tests. Must be a different database from DATABASE_URL.
TEST_DATABASE_URL=postgresql://aceva_app:CHANGE_ME@localhost:5432/aceva_test

# Private file storage (documents). Keep it OUTSIDE the web root and out of Git.
FILE_STORAGE_ROOT=E:\aceva-private-files

# Secrets are added in later milestones (M2/M3), for example:
#   DATA_ENCRYPTION_KEY  (32 random bytes, base64) for 2FA secrets, CNIC and bank numbers
#   SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASSWORD  (production email; local dev uses Mailpit)


# --- M2: login and sessions ---
# Redis holds the fast copy of every session. Local: portable Redis for Windows (no Docker). Managed alternative: Upstash.
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379
# 32 random bytes, base64. Encrypts 2FA secrets in the database. Create: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=CHANGE_ME
# Link base in password-reset emails
APP_URL=http://localhost:3000
# Email: local development uses Mailpit. Production: your real SMTP details (never commit them).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
#SMTP_USER=
#SMTP_PASSWORD=
MAIL_FROM=Aceva <no-reply@acevatech.com>
# Argon2id cost (defaults are OWASP-level; lower values only for local development)
#ARGON2_MEMORY_KIB=65536
#ARGON2_TIME_COST=3
# Number of reverse proxies in front of the API (production behind Nginx: 1)
#TRUST_PROXY=0
