# dependencies
node_modules/

# build output
dist/
.next/
out/
coverage/
*.tsbuildinfo
next-env.d.ts

# secrets and local config (only *.example files are committed)
.env
.env.*
!.env.example

# local private file storage and uploads (never committed)
/storage/
/uploads/
.local-storage/

# logs and OS files
npm-debug.log*
*.log
.DS_Store
Thumbs.db

# generated Prisma client
backend/src/generated/
test-results/
playwright-report/
e2e/.auth/

# npm download caches must never be committed. The cache lives in the user-level npm config (~/.npmrc), not in the repo.
npm-cache/
.npm/
_cacache/
# a Windows cache path written literally on Linux CI (the old project .npmrc said cache=E:\npm-cache)
E:*/
/E:*

# keys, certificates and credential files
*.pem
*.key
*.p12
*.pfx
*.keystore
id_rsa*
id_ed25519*
service-account*.json
credentials*.json

# local databases, dumps and backups (migrations stay tracked: *.sql is NOT ignored)
*.sqlite
*.sqlite3
*.db
*.dump
*.pgdump
*.backup
*.bak
*.sql.gz
backups/

# private files written when the backend runs from backend/ (backend/src/storage/ is source code and stays tracked)
/backend/storage/
/backend/uploads/

# downloaded payroll and finance exports (bank sheets, ledger CSVs, payslips) and real data files
/exports/
/private-data/
*bank-sheet*.csv
*HIGHLY-CONFIDENTIAL*
ledger-*.csv
payslip*.pdf

# temporary files and debug output
tmp/
temp/
.tmp/
*.tmp
*.swp
*~

# Playwright extras
blob-report/
playwright/.cache/

# tool caches
.eslintcache
.cache/
.turbo/
.nyc_output/
.vercel/

# IDE and OS
.vscode/
.idea/
desktop.ini
ehthumbs.db
$RECYCLE.BIN/
